rule VendorInvoiceInvoiceExchangeRateDefault when
	$e: VendorInvoice(invoiceExchangeRate == null)
then
	BigDecimal newRate = BigDecimal.ONE;
	if( $e.getInvoiceCurrency() != null ) {
		CPmtCurrencyRate pmtRate = droolsRuleProcedures.findCPmtCurrencyRateByCuyCodeAndDateFromLessThanEqualAndDateToGreaterThanEqualAndCompanyAndDeleted($e.getInvoiceCurrency(), currentLocalDate, $e.getCompany(), false);
		if( pmtRate != null && pmtRate.getInMainCuy() != null && pmtRate.getUnitOfCuy() != null) {
			newRate = pmtRate.getInMainCuy().divide( new BigDecimal(pmtRate.getUnitOfCuy()) );
		}
	}
	modify( $e ) {
		setInvoiceExchangeRate( newRate );
	}
end


