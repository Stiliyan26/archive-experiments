rule VendorInvoiceRowCreateAllocationRecord
when
	$e: VendorInvoiceRow(company != null && validationEvent.startsWith("after"))
	$at: AllocationType() from droolsRuleProcedures.findAllocationTypeByProducerAndConsumerAndCompanyAndDeleted("vendorInvoiceRows","cDeliveryDetails", $e.company, false)
	$ap1: ( AllocationProxy(allocationType == $at && fullyAllocated != true && deleted == false) from $e.allocationProxies
		or AllocationProxy(allocationOrigin == $e && allocationType == $at && fullyAllocated != true && deleted == false) )
	$dd: CDeliveryDetail(deyId.parId == $e.invoice!.invoiceCounterParty) from droolsRuleProcedures.findCDeliveryDetailByGodIdAndCompanyAndDeleted($e.goods, $e.company, false) //TODO orderby???
	$ap2: AllocationProxy(allocationType == $at && fullyAllocated != true && deleted == false) from $dd.allocationProxies
	accumulate(
		$arp: AllocationRecord( deleted == false, allocationProducer == $ap1, $pQty: allocatedQuantity );
		$sumProducerQuantityCreated: sum( $pQty )
	)
then
	BigDecimal amount;
	BigDecimal consumerAmount = $ap2.getQuantityToAllocate().compareTo(new BigDecimal(-1)) == 0 ? null : $ap2.getQuantityToAllocate().subtract($ap2.getTotalAllocatedQuantity());
	BigDecimal producerAmount = $ap1.getQuantityToAllocate().compareTo(new BigDecimal(-1)) == 0 ? consumerAmount : $ap1.getQuantityToAllocate().subtract($ap1.getTotalAllocatedQuantity()).subtract( $sumProducerQuantityCreated );
	if((consumerAmount == null || producerAmount.compareTo(consumerAmount) < 0)) {
		amount = producerAmount;
	} else {
		amount = consumerAmount;
	}
	if( amount.compareTo(BigDecimal.ZERO) > 0 ) {
		AllocationRecord newRecord = new AllocationRecord(null,null,null,null, false, $e.getCompany(), amount, $ap2, $ap1);
		//entitiesToBeSaved.add(newRecord);
		newRecord = (AllocationRecord) droolsRuleProcedures.save(newRecord); //save immediately to avoid the TransientObjectException
		insert( newRecord );
		
		warnings.add("VendorInvoiceRow automatic create AllocationRecord: "+$e.getId(), false);
	}
end

