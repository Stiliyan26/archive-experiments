rule COrderDetailCreateAllocationRecord
when
	$e: COrderDetail(company != null && validationEvent.startsWith("after"))
	$at: AllocationType() from droolsRuleProcedures.findAllocationTypeByProducerAndConsumerAndCompanyAndDeleted("cOfferDetails","cOrderDetails", $e.company, false)
	$ap2: ( AllocationProxy(allocationType == $at && fullyAllocated != true && deleted == false) from $e.allocationProxies
	//$ap2: ( AllocationProxy(fullyAllocated != true) from droolsRuleProcedures.findAllocationProxyByAllocationOriginAndAllocationTypeAndCompanyAndDeleted($e,$at,$e.company,false)
		or AllocationProxy(allocationOrigin == $e && allocationType == $at && fullyAllocated != true && deleted == false) )
	$od: COfferDetail() from droolsRuleProcedures.findCOfferDetailByGodIdAndCompanyAndDeleted($e.godId, $e.company, false) //TODO orderby???
	$ap1: AllocationProxy(allocationType == $at && fullyAllocated != true && deleted == false) from $od.allocationProxies
	//$ap1: AllocationProxy(fullyAllocated != true) from droolsRuleProcedures.findAllocationProxyByAllocationOriginAndAllocationTypeAndCompanyAndDeleted($od,$at,$od.company,false)
	accumulate(
		$arc: AllocationRecord( deleted == false, allocationConsumer == $ap2, $cQty: allocatedQuantity );
		$sumConsumerQuantityCreated: sum( $cQty )
	)
then
	//System.out.println("COrderDetailCreateAllocationRecord COrderDetail: "+$e.getId()+", AllocationProxy: "+$ap2.getId()+", COfferDetail: "+$od.getId()+", AllocationProxy: "+$ap1.getId());
	BigDecimal amount;
	BigDecimal consumerAmount = $ap2.getQuantityToAllocate().compareTo(new BigDecimal(-1)) == 0 ? null : $ap2.getQuantityToAllocate().subtract($ap2.getTotalAllocatedQuantity());
	BigDecimal producerAmount = $ap1.getQuantityToAllocate().compareTo(new BigDecimal(-1)) == 0 ? consumerAmount : $ap1.getQuantityToAllocate().subtract($ap1.getTotalAllocatedQuantity()).subtract( $sumConsumerQuantityCreated );
	if((consumerAmount == null || producerAmount.compareTo(consumerAmount) < 0)) {
		amount = producerAmount;
	} else {
		amount = consumerAmount;
	}
	//System.out.println("COrderDetailCreateAllocationRecord consumerAmount: "+consumerAmount+", producerAmount: "+producerAmount+", amount: "+amount);
	if( amount.compareTo(BigDecimal.ZERO) > 0 ) {
		AllocationRecord newRecord = new AllocationRecord(null,null,null,null, false, $e.getCompany(), amount, $ap2, $ap1);
		//entitiesToBeSaved.add(newRecord);
		newRecord = (AllocationRecord) droolsRuleProcedures.save(newRecord); //save immediately to avoid the TransientObjectException
		insert( newRecord );
		
		warnings.add("COrderDetail automatic create AllocationRecord: "+$e.getId(), false);
	}
end


