end

rule FPtBatchAmountCalc when
	$e: FPtBatch(cuyRate != null && cuyUnit != null && amountCurrency != null)
	$old: FPtBatch($e.amount == null || cuyRate != $e.cuyRate || cuyUnit != $e.cuyUnit || amountCurrency != $e.amountCurrency) from cleanEmWrapper.getOriginalEntity($e)
then
	BigDecimal amount = $e.getCuyRate().divide(new BigDecimal($e.getCuyUnit())).multiply($e.getAmountCurrency()).setScale(2,BigDecimal.ROUND_HALF_UP);
	if($e.getAmount() == null || $e.getAmount().compareTo(amount) != 0) {
		modify( $e ) {
