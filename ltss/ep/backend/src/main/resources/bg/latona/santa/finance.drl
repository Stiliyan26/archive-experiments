rule FPtBatchAmountOutstandingCalc when
	$e: FPtBatch(cuyRate != null && cuyUnit != null && amountOutstandingCurrency != null)
	$old: FPtBatch($e.amountOutstanding == null || cuyRate != $e.cuyRate || cuyUnit != $e.cuyUnit || amountOutstandingCurrency != $e.amountOutstandingCurrency) from cleanEmWrapper.getOriginalEntity($e)
then
	BigDecimal amountOutstanding = $e.getCuyRate().divide(new BigDecimal($e.getCuyUnit())).multiply($e.getAmountOutstandingCurrency()).setScale(2,BigDecimal.ROUND_HALF_UP);
	if($e.getAmountOutstanding() == null || $e.getAmountOutstanding().compareTo(amountOutstanding) != 0) {
		modify( $e ) {
