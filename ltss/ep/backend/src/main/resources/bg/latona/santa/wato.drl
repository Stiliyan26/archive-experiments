rule NewArticlePriceRateFromImportedArticle
when
	$impArt: ImportedArticle(article != null)
	$curr: Currency() from droolsRuleProcedures.findCurrencyByNameAndCompany($impArt.currency, $impArt.company)
	not ArticlePriceRate(
		(validToDate == null || validToDate > currentLocalDate)
	) from droolsRuleProcedures.findArticlePriceRateByVendorAndArticle(null, $impArt.article)
then
	ArticlePriceRate articlePriceRate = new ArticlePriceRate(null,null,null,null, false, $impArt.getCompany(),
			null,
			$impArt.getArticle(), 
			$impArt.getSellPrice(),
			$curr, 
			currentLocalDate,
			LocalDate.of(3000,01,01)
		);
	entitiesToBeSaved.add(articlePriceRate);
	insert( articlePriceRate );
	warnings.add("ImportedArticle automatic import to ArticlePriceRate", false);
end

rule UpdateArticlePriceRateFromImportedArticle
when
	$impArt: ImportedArticle(article != null)
	$curr: Currency() from droolsRuleProcedures.findCurrencyByNameAndCompany($impArt.currency, $impArt.company)
	$apr: ArticlePriceRate(
		($impArt.sellPrice != $apr.price || $curr != $apr.currency)
		&& (validToDate == null || validToDate > currentLocalDate)
		&& (validFromDate == null || validFromDate < currentLocalDate)
	) from droolsRuleProcedures.findArticlePriceRateByVendorAndArticle(null, $impArt.article)
then
	$apr.setValidToDate( currentLocalDate );
	entitiesToBeSaved.add( $apr );
	insert( $apr );
	ArticlePriceRate articlePriceRate = new ArticlePriceRate(null,null,null,null, false, $impArt.getCompany(),
			null,
			$impArt.getArticle(), 
			$impArt.getSellPrice(),
			$curr, 
			currentLocalDate,
			LocalDate.of(3000,01,01)
		);
	entitiesToBeSaved.add(articlePriceRate);
	insert( articlePriceRate );
	warnings.add("ImportedArticle automatic update of ArticlePriceRate", false);
end


