rule LegalPersonEikValidation
	salience -999
when
	$su: LegalPerson(
	    eik != null && deleted == false
	    && (eik.matches("[0-9]+") == false
	    || eik != null && eik.length() > 13
	    || eik != null && eik.length() < 9))
then
     warnings.rejectValue("LegalPerson","eik","InputValidationFrom9To13Digits",null);
end
