	warnings.rejectValue("FPtBatch","descr","notNull",null);
end

rule FPtBatchUniqueInvoice
	salience -999
when
	$new: FPtBatch(company != null 
		&& bteId != null && bteId.isDds == true 
		&& ideId != null)
	$old: FPtBatch(id != $new.id && ideId!.side == $new.ideId!.side) from droolsRuleProcedures.findFPtBatchByPostDateAndOutCodeAndRefNoAndBteIdAndParIdAndCompanyAndDeleted($new.postDate, $new.outCode, $new.refNo, $new.bteId, $new.parId, $new.company, false)
then
	warnings.rejectValue($new.getClass().getSimpleName(),"uniqueness","notUnique",$old);
end

rule FPtBatchAmount3CurrencyCalc when
	$e: FPtBatch(amount2Currency != null && ideId!.percentVat != null)
	$old: FPtBatch($e.amount3Currency == null  || amount2Currency != $e.amount2Currency || ideId!.percentVat != $e.ideId!.percentVat) from cleanEmWrapper.getOriginalEntity($e)
then
	BigDecimal amount3Currency = $e.getAmount2Currency().multiply($e.getIdeId().getPercentVat().divide(new BigDecimal(100))).setScale(2,BigDecimal.ROUND_HALF_UP);
	if($e.getAmount3Currency() == null || $e.getAmount3Currency().compareTo(amount3Currency) != 0) {
		modify( $e ) {
			setAmount3Currency(amount3Currency);
		}
	}
end

rule FPtBatchAmountCurrencyCalc when
	$e: FPtBatch(amount2Currency != null && amount3Currency != null)
	$old: FPtBatch($e.amountCurrency == null  || amount2Currency != $e.amount2Currency || amount3Currency != $e.amount3Currency) from cleanEmWrapper.getOriginalEntity($e)
then
	BigDecimal amountCurrency = $e.getAmount2Currency().add($e.getAmount3Currency());
	if($e.getAmountCurrency() == null || $e.getAmountCurrency().compareTo(amountCurrency) != 0) {
		modify( $e ) {
			setAmountCurrency(amountCurrency);
		}
	}
end

rule FPtBatchAmount2Calc when
	$e: FPtBatch(cuyRate != null && cuyUnit != null && amount2Currency != null)
	$old: FPtBatch($e.amount2 == null || cuyRate != $e.cuyRate || cuyUnit != $e.cuyUnit || amount2Currency != $e.amount2Currency) from cleanEmWrapper.getOriginalEntity($e)
then
	BigDecimal amount2 = $e.getCuyRate().divide(new BigDecimal($e.getCuyUnit())).multiply($e.getAmount2Currency()).setScale(2,BigDecimal.ROUND_HALF_UP);
	if($e.getAmount2() == null || $e.getAmount2().compareTo(amount2) != 0) {
		modify( $e ) {
			setAmount2(amount2);
		}
	}
end

rule FPtBatchAmount3Calc when
	$e: FPtBatch(cuyRate != null && cuyUnit != null && amount3Currency != null)
	$old: FPtBatch($e.amount3 == null || cuyRate != $e.cuyRate || cuyUnit != $e.cuyUnit || amount3Currency != $e.amount3Currency) from cleanEmWrapper.getOriginalEntity($e)
then
	BigDecimal amount3 = $e.getCuyRate().divide(new BigDecimal($e.getCuyUnit())).multiply($e.getAmount3Currency()).setScale(2,BigDecimal.ROUND_HALF_UP);
