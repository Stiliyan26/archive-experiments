rule COrderDetailCreateOrderTotal when
	$e: COrderDetail(quantityConfirm != null && price != null && validationEvent.startsWith("beforeCreate"))
	$o: COrder() from $e.orrId
then
	BigDecimal newTotal = $e.getQuantityConfirm().multiply($e.getPrice()).add($o.getTotal());
	insert( $o );
	modify( $o ) {
		setTotal( newTotal )
	}
	entitiesToBeSaved.add( $o );
end

rule COrderDetailDeleteOrderTotal when
	$e: COrderDetail(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$old: COrderDetail(quantityConfirm != null && price != null) from cleanEmWrapper.getOriginalEntity($e)
	$o: COrder() from $old.orrId
then
	BigDecimal total = $o.getTotal();
	if( total == null ) {
		total = BigDecimal.ZERO;
	}
	BigDecimal newTotal = total.subtract($old.getQuantityConfirm().multiply($old.getPrice()));
	insert( $o );
	modify( $o ) {
		setTotal( newTotal )
	}
	entitiesToBeSaved.add( $o );
end

rule COrderDetailUpdateOrderTotal when
	$e: COrderDetail(validationEvent.startsWith("beforeSave"))
	$old: COrderDetail(quantityConfirm != $e.quantityConfirm || price != $e.price ) from cleanEmWrapper.getOriginalEntity($e)
	$o: COrder() from $e.orrId
then
	BigDecimal total = $o.getTotal();
	if( total == null ) {
		total = BigDecimal.ZERO;
	}
	BigDecimal newTotal = total.add($e.getQuantityConfirm().multiply($e.getPrice())).subtract($old.getQuantityConfirm().multiply($old.getPrice()));
	insert( $o );
	modify( $o ) {
		setTotal( newTotal )
	}
	entitiesToBeSaved.add( $o );
end

rule COrderDetailUpdateOrderStatusCf when
	$e: COrderDetail(deleted != true && quantityConfirm != null && ddlQuantity != null && cancelledQuantity != null && 
					quantityConfirm != (ddlQuantity + cancelledQuantity) && company != null && validationEvent.startsWith("beforeSave"))
	$o: COrder(status != null && status.listOptionItemCode == LoiOrderStatus.ORDER_STATUS_FN) from $e.orrId
	$s: LoiOrderStatus() from droolsRuleProcedures.findLoiOrderStatusByCodeAndCompanyAndDeleted(LoiOrderStatus.ORDER_STATUS_CF, $e.company, false)
then
	insert( $o );
	modify( $o ) {
		setStatus( $s ),
		setFinishDate( null )
	}
	entitiesToBeSaved.add( $o );
end

rule COrderDetailUpdateOrderStatusFn when
	$e: COrderDetail(quantityConfirm != null && ddlQuantity != null && cancelledQuantity != null && 
					quantityConfirm == (ddlQuantity + cancelledQuantity) && company != null && validationEvent.startsWith("beforeSave"))
	$o: COrder(status != null && status.listOptionItemCode == LoiOrderStatus.ORDER_STATUS_CF) from $e.orrId
	$s: LoiOrderStatus() from droolsRuleProcedures.findLoiOrderStatusByCodeAndCompanyAndDeleted(LoiOrderStatus.ORDER_STATUS_FN, $e.company, false)
	accumulate(
		COrderDetail(deleted != true && quantityConfirm != (ddlQuantity + cancelledQuantity)) from $o.orderDetails; 
		$cnt: count();
		$cnt == 0
	)
then
	insert( $o );
	modify( $o ) {
		setStatus( $s ),
		setFinishDate( currentDate )
	}
	entitiesToBeSaved.add( $o );
end


rule COfferUpdateCReserveQuantityTerm when
	$o: COffer(id != null && company != null && validationEvent.startsWith("before"))
	$rq: CReserveQuantity()  from droolsRuleProcedures.findCReserveQuantityByOfrIdAndCompanyAndDeleted($o, $o.company, false)
then
	COffer origO = (COffer) cleanEmWrapper.getOriginalEntity($o);
	if(origO.getEndDate() != $o.getEndDate()) {
		insert( $rq );
		modify( $rq ) {
			setTerm($o.getEndDate());
		}
		entitiesToBeSaved.add( $rq );
	}
end


rule CDeliveryActivateDeliveryDetailCostCalc when
	$e: CDelivery()
	$old: CDelivery(costMethod!.listOptionItemCode != $e.costMethod!.listOptionItemCode) from cleanEmWrapper.getOriginalEntity($e)
then
	for( CDeliveryDetail dd : $e.getDeliveryDetails() ) {
		if( dd.getGodId() != null ) {
			insert( dd );
		}
	}
end

rule CDeliveryCalculate 
	salience 0
when
	$e: CDelivery(oblSum != null && vatSum != null && sum != null)
then
	BigDecimal STO = new BigDecimal( 100 );
	BigDecimal discount = STO.subtract( $e.getDiscount() ).divide( STO );
	BigDecimal danOsnova = $e.getOblSum().multiply( discount ).setScale(2, BigDecimal.ROUND_HALF_UP);
	BigDecimal vatTo = $e.getVatSum().multiply( discount ).setScale(2, BigDecimal.ROUND_HALF_UP);
	BigDecimal endSum = $e.getSum().multiply( discount ).setScale(2, BigDecimal.ROUND_HALF_UP);
	BigDecimal total = endSum.add( vatTo );
	if( $e.getDanOsnova().compareTo( danOsnova ) != 0 || $e.getEndSum().compareTo( endSum ) != 0 || $e.getTotal().compareTo( total ) != 0 ) {
		modify( $e ) {
			setDanOsnova( danOsnova ),
			setEndSum( endSum ),
			setTotal( total )
		}
	}
end

rule CDeliveryPostedCheck when
	$e: CDelivery(id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeSave") 
		|| deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$old: CDelivery(posted == "Y") from cleanEmWrapper.getOriginalEntity($e) //already booked
then
	if( $e.getPosted() == "X" && validationEvent.startsWith("beforeSave") ) {
		modify( $e ) {
			setPosted( "Y" )
		}
	} else {
		warnings.rejectValue("CDelivery","posted","cannotChangeBookedDoc",null);
	}
end


