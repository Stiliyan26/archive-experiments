global bg.latona.santa.DroolsRepositoryValidator.Result warnings;

global String validationEvent;
global Date currentDate;
global java.util.LinkedList<CommonRecord> entitiesToBeSaved;
global bg.latona.santa.DroolsRuleProcedures droolsRuleProcedures;
global bg.latona.santa.DroolsRuleProcedures.CleanEmWrapper cleanEmWrapper;

//TransportOrder
rule TransportOrderTransporterDefault when
	$to: TransportOrder(transporter == null)
	$lp: LegalPerson() from droolsRuleProcedures.findLegalPersonByEik("204074306")
then
	modify( $to ) {
		setTransporter( $lp );
	}
	warnings.add($to.getClass().getName()+".transporter default", false);
end


rule VehicleAssetNameNull 
	salience -999
when
	$v: Vehicle(deleted == false && (assetName == null || assetName.trim().isEmpty()) && (licensePlate == null || licensePlate.trim().isEmpty() || vehicleType == null) )
then
	warnings.rejectValue("Vehicle","assetName","notNull",null);
end

rule VehicleAssetNameDefault when
	$v: Vehicle(assetName == null && licensePlate != null && vehicleType != null)
then
	modify( $v ) {
		setAssetName($v.getVehicleType().getListOptionItemName() + " " + $v.getLicensePlate());
	}
	warnings.add($v.getClass().getName()+".assetName default", false);
end

