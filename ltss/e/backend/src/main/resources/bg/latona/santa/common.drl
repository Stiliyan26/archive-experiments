rule CSaleCalculateFromDetails 
	salience 10
when
	$e: CSaleDetail(totalWhtVat != null && vat != null && validationEvent.startsWith("before"))
	$d: CSale() from $e.saeId
	accumulate(
		$dd: CSaleDetail(id != $e.id, deleted != true, $total: total, $totalWhtVat: totalWhtVat, $vat: vat, $discount: discount) from $d.saleDetails; 
		$totalSum: sum($total),
		$sumSum: sum($totalWhtVat.setScale(2, BigDecimal.ROUND_HALF_UP)),
		$valOblSum: sum(( $vat.compareTo( BigDecimal.ZERO ) != 0 ) ? $totalWhtVat.setScale(2, BigDecimal.ROUND_HALF_UP) : BigDecimal.ZERO),
		$vattoSum: sum( $totalWhtVat.setScale(2, BigDecimal.ROUND_HALF_UP).multiply( $vat ).divide(new BigDecimal( 100 )).setScale(2, BigDecimal.ROUND_HALF_UP) )
	)
then
	insert( $d );
	if( ($e.isDeleted() == true || $e.getId() == ((CommonRecord)triggerObject).getId() && validationEvent.startsWith("beforeDelete")) ) { //"deleted" attribute becomes true in the "afterDelete" event - we can't check it in the before events
		modify( $d ) {
			setTotal( $totalSum ),
			setSum( $sumSum ),
			setOblSum( $valOblSum ),
			setVatto( $vattoSum )
		}
	} else {
		BigDecimal total = $totalSum.add( $e.getTotal() );
		BigDecimal sum = $sumSum.add( $e.getTotalWhtVat().setScale(2, BigDecimal.ROUND_HALF_UP) );
		BigDecimal oblSum = $valOblSum.add( ( $e.getVat().compareTo( BigDecimal.ZERO ) != 0 ) ? $e.getTotalWhtVat().setScale(2, BigDecimal.ROUND_HALF_UP) : BigDecimal.ZERO );
		BigDecimal vatto = $vattoSum.add( $e.getTotalWhtVat().setScale(2, BigDecimal.ROUND_HALF_UP).multiply( $e.getVat() ).divide(new BigDecimal( 100 )).setScale(2, BigDecimal.ROUND_HALF_UP) );
		modify( $d ) {
			setTotal( total ),
			setSum( sum ),
			setOblSum( oblSum ),
			setVatto( vatto )
		}
	}
	entitiesToBeSaved.add( $d );
end

rule CSaleDetailCalculate 
	salience 20
when
	$e: CSaleDetail(price != null && quantity != null && vat != null && discount != null)
then
	BigDecimal STO = new BigDecimal( 100 );
	BigDecimal discount = STO.subtract( $e.getDiscount() ).divide( STO );
	BigDecimal priceVat = $e.getPrice().multiply( STO.add( $e.getVat() ).divide( STO )).setScale(2, BigDecimal.ROUND_HALF_UP);
	BigDecimal discValue = priceVat.multiply( $e.getDiscount() ).divide( STO ).multiply($e.getQuantity()).setScale(2, BigDecimal.ROUND_HALF_UP);
	BigDecimal total = priceVat.multiply($e.getQuantity()).subtract( discValue );
	BigDecimal totalVat = total.multiply( $e.getVat() ).divide(STO.add( $e.getVat() ), 2, RoundingMode.HALF_UP);
	BigDecimal totalWhtVat = total.subtract( totalVat );
	
	//BigDecimal obl = ( $e.getVat().compareTo( BigDecimal.ZERO ) != 0 ) ? totalWhtVat.setScale(2, BigDecimal.ROUND_HALF_UP) : BigDecimal.ZERO;
	
	if( $e.getPriceVat() == null || $e.getTotal() == null || $e.getTotalVat() == null || $e.getTotalWhtVat() == null
			|| $e.getPriceVat().compareTo( priceVat ) != 0 || $e.getTotal().compareTo( total ) != 0 
			|| $e.getTotalVat().compareTo( totalVat ) != 0 || $e.getTotalWhtVat().compareTo( totalWhtVat ) != 0 
	) {
		modify( $e ) {
			setPriceVat( priceVat ),
			setTotal( total ),
			setTotalVat( totalVat ),
			setTotalWhtVat( totalWhtVat )
		}
	}
end

rule CSaleCalculate 
	salience 0
when
	$e: CSale(oblSum != null && vatto != null && sum != null)
then
	BigDecimal STO = new BigDecimal( 100 );
	BigDecimal discount = STO.subtract( $e.getDiscount() ).divide( STO );
	BigDecimal danOsnova = $e.getOblSum().multiply( discount ).setScale(2, BigDecimal.ROUND_HALF_UP);
	BigDecimal vatSum = $e.getVatto().multiply( discount ).setScale(2, BigDecimal.ROUND_HALF_UP);
	BigDecimal endSum = $e.getSum().multiply( discount ).setScale(2, BigDecimal.ROUND_HALF_UP);
	BigDecimal total = endSum.add( vatSum );
	if( $e.getDanOsnova().compareTo( danOsnova ) != 0 || $e.getEndSum().compareTo( endSum ) != 0 || $e.getTotal().compareTo( total ) != 0 ) {
		modify( $e ) {
			setDanOsnova( danOsnova ),
			setEndSum( endSum ),
			setTotal( total )
		}
	}
end

