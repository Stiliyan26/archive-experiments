//check_posting
rule FPtPostingAmountNull
	salience -999
when
	$su: FPtPosting(deleted == false && amount == null)
then
	warnings.rejectValue("FPtPosting","amount","notNull",null);
end

rule FPtPostingAmountDefaultAndCalc when
	$e: FPtPosting(amountCurrency != null && jolId != null && jolId.cuyRate != null && jolId.cuyUnit != null)
then
	FPtPosting old = (FPtPosting) cleanEmWrapper.getOriginalEntity($e);
	if($e.getAmount() == null || old == null || old != null && old.getAmountCurrency() != null && $e.getAmountCurrency().compareTo(old.getAmountCurrency()) != 0) {
		BigDecimal amount = ($e.getJolId().getCuyRate().divide(new BigDecimal($e.getJolId().getCuyUnit()))).multiply($e.getAmountCurrency());
		if($e.getAmount() == null || amount.compareTo($e.getAmount()) != 0) {
			modify( $e ) {
				setAmount( amount )
			}
		}
	}
end

//check_posting
rule FPtPostingAmountCurrencyNull
	salience -999
when
	$su: FPtPosting(deleted == false && amountCurrency == null)
then
	warnings.rejectValue("FPtPosting","amountCurrency","notNull",null);
end

rule FPtPostingAmountCurrencyDefault when
	$e: FPtPosting(amountCurrency == null && jolId != null && jolId.bahId != null)
	accumulate(
		$pt: FPtPosting(id != $e.id, deleted != true, $amountCurrency: amountCurrency) from $e.jolId.fPtPostings; 
		$sumRows: sum($amountCurrency),
		$countRows: count()
	)
then
	BigDecimal amount = $e.getJolId().getBahId().getAmount2Currency();
	if($countRows > 0) {
		amount = $e.getJolId().getBahId().getAmountCurrency().subtract($sumRows);
	}
	
	modify( $e ) {
		setAmountCurrency( amount )
	}
end

