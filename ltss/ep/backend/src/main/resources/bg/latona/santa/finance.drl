rule FCtBatchTypeRuleUpdateDependenceIdFake when
	$e: FCtBatchTypeRule(dependenceIdFake != null && validationEvent.startsWith("beforeCreate") && company != null)
	$loi: LoiBatchTypeRuleDependenceType() from droolsRuleProcedures.findLoiBatchTypeRuleDependenceTypeByListOptionItemCodeAndCompanyAndDeleted($e.dependenceTypeStringToCode($e.dependenceIdFake.substring(0,3)), $e.company, false)
then
	Long newDependenceIdInt = Long.valueOf($e.getDependenceIdFake().substring(3));
	modify( $e ) {
		setDependenceId(newDependenceIdInt),
		setDependenceType($loi)
	}
end

rule FCtBatchTypeRuleActiveToDateCheck when
	$e: FCtBatchTypeRule(deleted == false && activeFromDate != null && activeToDate != null && activeFromDate.compareTo(activeToDate) > 0)
then
	warnings.rejectValue("FCtBatchTypeRule","activeToDate","dateError",null);
end

rule FCtBatchTypeRuleCheckRule when
	$e: FCtBatchTypeRule(deleted == false && activeFromDate != null && activeToDate != null
			&& outCode != null && tteId != null && rueId != null && orderNum != null && company != null
		)
	$btr: FCtBatchTypeRule(
			(
				(activeFromDate.compareTo($e.activeFromDate) < 0) && (activeToDate.compareTo($e.activeFromDate) > 0) 
				|| (activeFromDate.compareTo($e.activeToDate) < 0) && (activeToDate.compareTo($e.activeToDate) > 0)
			)
			&& id != $e.id
		) from droolsRuleProcedures.findFCtBatchTypeRuleByOutCodeAndTteIdAndRueIdAndOrderNumAndDependenceTypeAndDependenceIdAndCompanyAndDeleted($e.outCode,$e.tteId,$e.rueId,$e.orderNum,$e.dependenceType,$e.dependenceId,$e.company,false)
then
	warnings.rejectValue("FCtBatchTypeRule","orderNum","checkRuleError",null);
end

rule FCtBatchTypeRuleTransactionCheck when
	$e: FCtBatchTypeRule(deleted == false && activeFromDate != null && activeToDate != null
			&& outCode != null && tteId != null && rueId != null && company != null
		)
	$btr: FCtBatchTypeRule(
			(
				(activeFromDate.compareTo($e.activeFromDate) < 0) && (activeToDate.compareTo($e.activeFromDate) > 0) 
				|| (activeFromDate.compareTo($e.activeToDate) < 0) && (activeToDate.compareTo($e.activeToDate) > 0)
			)
			&& rueId != $e.rueId 
			&& id != $e.id 
		) from droolsRuleProcedures.findFCtBatchTypeRuleByOutCodeAndTteIdAndCompanyAndDeleted($e.outCode, $e.tteId, $e.company,false)
then
	warnings.rejectValue("FCtBatchTypeRule","rueId","transactionCheckError",null);
end

rule FCtBatchTypeRuleActivePeriodCheck when
	$e: FCtBatchTypeRule(deleted == false && activeFromDate != null && activeToDate != null
			&& outCode != null && tteId != null && rueId != null && company != null
		)
	$btr: FCtBatchTypeRule(
			((activeFromDate.compareTo($e.activeFromDate) != 0) || (activeToDate.compareTo($e.activeToDate) != 0))
			&& orderNum != $e.orderNum
			&& id != $e.id
		) from droolsRuleProcedures.findFCtBatchTypeRuleByOutCodeAndTteIdAndRueIdAndDependenceTypeAndDependenceIdAndCompanyAndDeleted($e.outCode,$e.tteId,$e.rueId,$e.dependenceType,$e.dependenceId,$e.company,false)
then
	warnings.rejectValue("FCtBatchTypeRule","activeFromDate","activePeriodError",null);
end

rule FCtBatchTypeRuleDependenceTypeCheck when
	$e: FCtBatchTypeRule(deleted == false && dependenceType != null && dependenceIdFake == null)
then
	warnings.rejectValue("FCtBatchTypeRule","dependenceType","dependenceTypeError",null);
end

rule FCtBatchTypeRuleCheckCCtPartnerGroupId when
	$e: FCtBatchTypeRule(deleted == false && dependenceType!.listOptionItemCode == LoiBatchTypeRuleDependenceType.BATCH_TYPE_RULE_DEPENDENCE_TYPE_PRT)
	$prt: CCtPartnerGroup(deleted == false && !(
			(activeFrom.compareTo($e.activeFromDate) < 0) 
			&& (activeTo.compareTo($e.activeFromDate) > 0) 
			&& (activeFrom.compareTo($e.activeToDate) < 0) 
			&& (activeTo.compareTo($e.activeToDate) > 0)
		)) from droolsRuleProcedures.findCCtPartnerGroupByIdAndCompanyAndDeleted($e.dependenceId, $e.company, false)
then
	warnings.rejectValue("FCtBatchTypeRule","dependenceType","partnerGroupIdError",null);
end

rule FCtBatchTypeRuleCheckCCtCCtBankAccountId when
	$e: FCtBatchTypeRule(deleted == false && dependenceType!.listOptionItemCode == LoiBatchTypeRuleDependenceType.BATCH_TYPE_RULE_DEPENDENCE_TYPE_BAK)
	$cba: CCtBankAccount(!(
			(activeFrom.compareTo($e.activeFromDate) < 0) 
			&& (activeTo.compareTo($e.activeFromDate) > 0) 
			&& (activeFrom.compareTo($e.activeToDate) < 0) 
			&& (activeTo.compareTo($e.activeToDate) > 0)
		)) from droolsRuleProcedures.findCCtBankAccountByIdAndCompanyAndDeleted($e.dependenceId, $e.company, false)
then
	warnings.rejectValue("FCtBatchTypeRule","dependenceType","bankAccountIdError",null);
end

