//Events
rule EventAddToQueue
when
	$e: UserActionEvent( queuedTime == null && validationEvent.startsWith("afterCreate") )
then
	camelContext.createProducerTemplate().asyncSendBody("direct:"+$e.getClass().getSimpleName(), $e );
	modify( $e ) {
		setQueuedTime( ZonedDateTime.now() );
	}
end
