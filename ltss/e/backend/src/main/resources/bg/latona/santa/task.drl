rule TaskStatusDefault when
	$t: Task(status == null && company != null)
	$ts: TaskStatus() from droolsRuleProcedures.findTaskStatusByCodeAndCompany(TaskStatus.TASK_STATUS_PLANNED, $t.company)
then
	modify( $t ) {
		setStatus( $ts );
	}
	warnings.add("Task.status default", false);
end

rule TaskTitleDefault when
	$t: Task(title == null || title.length() == 0 || title.trim().isEmpty())
then
	modify( $t ) {
		setTitle( "Задача" );
	}
	warnings.add("Task.title default", false);
end

rule TaskAssignedStatusValidation when
	$t: Task(deleted == false && assigned == null, status != null, status.code != null, status.code.equals(TaskStatus.TASK_STATUS_ASSIGNED))
then
	warnings.rejectValue("Task","status","status.assignedWithoutUser",$t.getStatus());
end


