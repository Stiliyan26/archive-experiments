rule NewArticleProductFromImportedArticle
when
	$impArt: ImportedArticle(article == null, articleType == 5)
	not Article() from droolsRuleProcedures.findArticleByForeignId( $impArt.foreignId )
then
	ArticleProduct articleProduct = new ArticleProduct(null,null,null,null, false, $impArt.getCompany(),
			$impArt.getName() == null ? null : $impArt.getName(), 
			$impArt.getForeignId(),
			$impArt.getPredNom() == null ? null : $impArt.getPredNom(), 
			$impArt.getNomNom() == null ? null : $impArt.getNomNom(), 
			$impArt.getMeasureForeignId() == null ? null : $impArt.getMeasureForeignId(), 
			$impArt.getMeasure() == null ? null : $impArt.getMeasure(), 
			$impArt.getMeasureShort() == null ? null : $impArt.getMeasureShort()
		);
	entitiesToBeSaved.add(articleProduct);
	insert( articleProduct );
	$impArt.setArticle( articleProduct );
	entitiesToBeSaved.add($impArt);
	update( $impArt );
	warnings.add("ImportedArticle automatic import to ArticleProduct", false);
end

rule UpdateArticleProductFromImportedArticle
when
	$impArt: ImportedArticle(article != null && articleType == 5
		&& (name != null && name != article.name
			|| predNom != null && predNom != ((ArticleProduct) article).predNom
			|| nomNom != null && nomNom != ((ArticleProduct) article).nomNom
			|| measureForeignId != null && measureForeignId != ((ArticleProduct) article).measureForeignId
			|| measure != null && measure != ((ArticleProduct) article).measure
			|| measureShort != null && measureShort != ((ArticleProduct) article).measureShort
		)
	)
then
	ArticleProduct articleProduct = (ArticleProduct) $impArt.getArticle();
	if($impArt.getName() != null) articleProduct.setName($impArt.getName());
	if($impArt.getPredNom() != null) articleProduct.setPredNom($impArt.getPredNom());
	if($impArt.getNomNom() != null) articleProduct.setNomNom($impArt.getNomNom());
	if($impArt.getMeasureForeignId() != null) articleProduct.setMeasureForeignId($impArt.getMeasureForeignId());
	if($impArt.getMeasure() != null) articleProduct.setMeasure($impArt.getMeasure());
	if($impArt.getMeasureShort() != null) articleProduct.setMeasureShort($impArt.getMeasureShort());
	entitiesToBeSaved.add( articleProduct );
	insert( articleProduct );
	warnings.add("ImportedArticle automatic update of ArticleProduct", false);
end


