<Window x:Class="CurrencyAmounts.View.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CurrencyAmounts.ViewModel"
        xmlns:conv="clr-namespace:CurrencyAmounts.Converters"
        xmlns:enum="clr-namespace:CurrencyAmounts.Enum"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Invoice" Height="500" Width="800">

    <Window.Resources>
        <conv:CurrencyFormatterConverter x:Key="CurrencyFormatterConverter"/>
        <!-- ObjectDataProvider to get all values of CurrencyEnum -->
        <ObjectDataProvider x:Key="CurrencyEnumValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enum:CurrencyEnum"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Window.DataContext>
        <vm:InvoiceViewModel/>
    </Window.DataContext>

    <Grid>
        <StackPanel Margin="10">
            <!-- List of Invoice Items -->
            <ListView ItemsSource="{Binding InvoiceItems}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Description" 
                                        DisplayMemberBinding="{Binding Description}" 
                                        Width="200"/>
                        <GridViewColumn Header="Quantity" 
                                        DisplayMemberBinding="{Binding Quantity}" 
                                        Width="80"/>
                        <GridViewColumn Header="Amount per Unit" 
                                        DisplayMemberBinding="{Binding UnitAmount, StringFormat={}{0:F2}}" 
                                        Width="100"/>
                        <GridViewColumn Header="Currency" 
                                        DisplayMemberBinding="{Binding Currency}" 
                                        Width="80"/>
                        <GridViewColumn Header="Total Price" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <Binding Path="TotalPrice" StringFormat="{}{0:F2}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Display Calculations using MultiBinding with the Currency Formatter -->
            <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                <!-- Subtotal -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Subtotal: " FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource CurrencyFormatterConverter}">
                                <Binding Path="Subtotal"/>
                                <Binding Path="SelectedCurrency"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <!-- Item Discounts -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Item Discounts: " FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource CurrencyFormatterConverter}">
                                <Binding Path="ItemDiscount"/>
                                <Binding Path="SelectedCurrency"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <!-- Overall Discount -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Overall Discount: " FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource CurrencyFormatterConverter}">
                                <Binding Path="OverallDiscount"/>
                                <Binding Path="SelectedCurrency"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <!-- VAT -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="VAT: " FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource CurrencyFormatterConverter}">
                                <Binding Path="VATAmount"/>
                                <Binding Path="SelectedCurrency"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <!-- Final Total -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Final Total: " FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" Margin="5,0,0,0">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource CurrencyFormatterConverter}">
                                <Binding Path="FinalTotal"/>
                                <Binding Path="SelectedCurrency"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Overall Total -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Total: " FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center" Margin="5,0,0,0">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource CurrencyFormatterConverter}">
                            <Binding Path="Total"/>
                            <Binding Path="SelectedCurrency"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <!-- Currency Selection -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Select Currency: " VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Source={StaticResource CurrencyEnumValues}}"
                          SelectedItem="{Binding SelectedCurrency}"
                          Width="100" Margin="5,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
