	salience -999
when
	$e: FPtPosting(deleted == false && coaIdCt != null && (
			(coaIdCt.outRequired == true) && ccOutId == null
			|| (coaIdCt.ebkRequired == true) && ccEbkId == null
			|| (coaIdCt.funRequired == true) && ccFunId == null
			|| (coaIdCt.prmRequired == true) && ccPrmId == null
			|| (coaIdCt.fieRequired == true) && ccFieId == null
			|| (coaIdCt.parRequired == true) && ccParId == null
			|| (coaIdCt.gteRequired == true) && ccGteId == null
			|| (coaIdCt.cotRequired == true) && ccCotId == null
			|| (coaIdCt.re1Required == true) && ccRe1Id == null
			|| (coaIdCt.re2Required == true) && ccRe2Id == null
		))
then
	warnings.rejectValue("FPtPosting","coaIdCt","missingRequiredCostCenter",null);
end

