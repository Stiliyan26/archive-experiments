//triggerIns != "Y" is used to ignore this rule
rule CPmtCurrencyRateDateInsertInsideAnotherPeriod when
	$e: CPmtCurrencyRate(id == null && triggerIns != "Y" && validationEvent.startsWith("before") && company != null && outCode != null && cuyCode != null)
	$intersecting: CPmtCurrencyRate(dateFrom < $e.dateFrom && !($e.dateFrom > dateTo)) from droolsRuleProcedures.findCPmtCurrencyRateByCuyCodeAndOutCodeAndCompanyAndDeleted($e.cuyCode, $e.outCode, $e.company, false)
then
	modify( $e ) {
		setDateTo( $intersecting.getDateTo() )
	}
	insert( $intersecting );
	modify( $intersecting ) {
		setDateTo( $e.getDateFrom().minusDays(1) )
	}
	entitiesToBeSaved.add($intersecting);
end

//triggerIns != "Y" is used to ignore this rule
rule CPmtCurrencyRateInsertUpdates when
	$e: CPmtCurrencyRate(id == null && triggerIns != "Y" && validationEvent.startsWith("before") && company != null && outCode != null && cuyCode != null)
	$intersecting: CPmtCurrencyRate(dateFrom.compareTo($e.dateFrom) == 0) from droolsRuleProcedures.findCPmtCurrencyRateByCuyCodeAndOutCodeAndCompanyAndDeleted($e.cuyCode, $e.outCode, $e.company, false)
then
	modify( $e ) {
		setId($intersecting.getId())
	}
end

//triggerIns != "Y" is used to ignore this rule
rule CPmtCurrencyRateInsertFirst when
	$e: CPmtCurrencyRate(id == null && triggerIns != "Y" && validationEvent.startsWith("before") && company != null && outCode != null && cuyCode != null)
	accumulate(
		CPmtCurrencyRate($dtFrom: dateFrom) from droolsRuleProcedures.findCPmtCurrencyRateByCuyCodeAndOutCodeAndCompanyAndDeleted($e.cuyCode, $e.outCode, $e.company, false); 
		$minDateFrom: min($dtFrom);
		$e.dateFrom < $minDateFrom
	)
then
	modify( $e ) {
		setDateTo( ((LocalDate) $minDateFrom).minusDays(1) )
	}
end

rule CPmtCurrencyRateDateUpdateInsideAnotherPeriod when
	$e: CPmtCurrencyRate(id != null && validationEvent.startsWith("before") && company != null && outCode != null && cuyCode != null) //update existing
	$old: CPmtCurrencyRate(dateFrom.compareTo($e.dateFrom) != 0) from cleanEmWrapper.getOriginalEntity($e) //dateFrom was changed
	$intersecting: CPmtCurrencyRate( dateFrom < $e.dateFrom && !($e.dateFrom > dateTo) ) from droolsRuleProcedures.findCPmtCurrencyRateByCuyCodeAndOutCodeAndCompanyAndDeleted($e.cuyCode, $e.outCode, $e.company, false) //dateFrom is inside an existing period
then
	CPmtCurrencyRate newRate = new CPmtCurrencyRate(null, null, null, null, false, $e.getCompany(),
							$e.getOutCode(), $e.getCuyCode(), $e.getDateFrom(), $intersecting.getDateTo(), $e.getUnitOfCuy(), $e.getInMainCuy(), $e.getPerMainCuy(), "Y");
	insert( newRate );
	entitiesToBeSaved.add( newRate );
	
	insert( $intersecting );
	modify( $intersecting ) {
		setDateTo( $e.getDateFrom().minusDays(1) )
	};
	entitiesToBeSaved.add($intersecting);
	
	//return old
	modify( $e ) {
		setOutCode($old.getOutCode()),
		setCuyCode($old.getCuyCode()),
		setDateFrom($old.getDateFrom()),
		setDateTo($old.getDateTo()),
		setUnitOfCuy($old.getUnitOfCuy()),
		setInMainCuy($old.getInMainCuy()),
		setPerMainCuy($old.getPerMainCuy())
	}
end

rule CPmtCurrencyRateDateUpdateShortenPeriod when
	$e: CPmtCurrencyRate(id != null && validationEvent.startsWith("before") && company != null && outCode != null && cuyCode != null) //update existing
	$old: CPmtCurrencyRate(dateFrom != $e.dateFrom && dateFrom < $e.dateFrom && !($e.dateFrom > dateTo)) from cleanEmWrapper.getOriginalEntity($e) //dateFrom is changed to be inside its original period (later)
then
	CPmtCurrencyRate newRate = new CPmtCurrencyRate(null, null, null, null, false, $e.getCompany(),
							$e.getOutCode(), $e.getCuyCode(), $e.getDateFrom(), $old.getDateTo(), $e.getUnitOfCuy(), $e.getInMainCuy(), $e.getPerMainCuy(), "Y");
	insert( newRate );
	entitiesToBeSaved.add( newRate );
	
	modify( $e ) {
		setDateTo( $e.getDateFrom().minusDays(1) ),
		setDateFrom($old.getDateFrom()),
		setCuyCode($old.getCuyCode()),
		setInMainCuy($old.getInMainCuy())
	}
end

rule CPmtCurrencyRateUpdateUpdates when
	$e: CPmtCurrencyRate(id != null && validationEvent.startsWith("before") && company != null && outCode != null && cuyCode != null) //update existing
	$old: CPmtCurrencyRate(dateFrom.compareTo($e.dateFrom) != 0) from cleanEmWrapper.getOriginalEntity($e) //dateFrom was changed
	$intersecting: CPmtCurrencyRate(id != $e.id && dateFrom.compareTo($e.dateFrom) == 0) from droolsRuleProcedures.findCPmtCurrencyRateByCuyCodeAndOutCodeAndCompanyAndDeleted($e.cuyCode, $e.outCode, $e.company, false) //matches start of another period
then
	insert( $intersecting );
	modify( $intersecting ) {
		setCuyCode($e.getCuyCode()),
		setUnitOfCuy($e.getUnitOfCuy()),
		setInMainCuy($e.getInMainCuy()),
		setPerMainCuy($e.getPerMainCuy())
	}
	entitiesToBeSaved.add($intersecting);
	
	//return old
	modify( $e ) {
		setOutCode($old.getOutCode()),
		setCuyCode($old.getCuyCode()),
		setDateFrom($old.getDateFrom()),
		setDateTo($old.getDateTo()),
		setUnitOfCuy($old.getUnitOfCuy()),
		setInMainCuy($old.getInMainCuy()),
		setPerMainCuy($old.getPerMainCuy())
	}
end

rule CPmtCurrencyRateUpdateFirst when
	$e: CPmtCurrencyRate(id != null && validationEvent.startsWith("before") && company != null && outCode != null && cuyCode != null) //update existing
	$old: CPmtCurrencyRate($e.dateFrom < dateFrom) from cleanEmWrapper.getOriginalEntity($e) //dateFrom was changed to be earlier
	accumulate(
		CPmtCurrencyRate($dtFrom: dateFrom, id != $e.id) from droolsRuleProcedures.findCPmtCurrencyRateByCuyCodeAndOutCodeAndCompanyAndDeleted($e.cuyCode, $e.outCode, $e.company, false); 
		$minDateFrom: min($dtFrom);
		$e.dateFrom < $minDateFrom
	)
then
	LocalDate newDate;
	if( $old.getDateFrom().isBefore( (LocalDate) $minDateFrom ) ) {
		newDate = $old.getDateFrom();
	} else {
		newDate = (LocalDate) $minDateFrom;
	}
	CPmtCurrencyRate newRate = new CPmtCurrencyRate(null, null, null, null, false, $e.getCompany(),
							$e.getOutCode(), $e.getCuyCode(), $e.getDateFrom(), newDate.minusDays(1), $e.getUnitOfCuy(), $e.getInMainCuy(), $e.getPerMainCuy(), "Y");
	insert( newRate );
	entitiesToBeSaved.add( newRate );
	
	//return old
	modify( $e ) {
		setOutCode($old.getOutCode()),
		setCuyCode($old.getCuyCode()),
		setDateFrom($old.getDateFrom()),
		setDateTo($old.getDateTo()),
		setUnitOfCuy($old.getUnitOfCuy()),
		setInMainCuy($old.getInMainCuy()),
		setPerMainCuy($old.getPerMainCuy())
	}
end

