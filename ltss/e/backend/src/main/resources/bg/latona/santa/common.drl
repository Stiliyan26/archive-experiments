rule CDeliveryCalculateFromDetails 
	salience 10
when
	$e: CDeliveryDetail(vatAll != null && valueAll != null && discount != null && validationEvent.startsWith("before"))
	$d: CDelivery() from $e.deyId
	accumulate(
		$dd: CDeliveryDetail(id != $e.id, deleted != true, $vatAll: vatAll, $valueAll: valueAll, $discount: discount) from $d.deliveryDetails; 
		$vatAllSum: sum($vatAll),
		$valDiscSum: sum($valueAll.multiply( (new BigDecimal( 100 )).subtract( $discount ).divide(new BigDecimal( 100 )) ).setScale(2, BigDecimal.ROUND_HALF_UP)),
		$valOblSum: sum($valueAll.multiply( (new BigDecimal( 100 )).subtract( $discount ).divide(new BigDecimal( 100 )) ))
	)
then
	insert( $d );
	if( ($e.isDeleted() == true || $e.getId() == ((CommonRecord)triggerObject).getId() && validationEvent.startsWith("beforeDelete")) ) { //"deleted" attribute becomes true in the "afterDelete" event - we can't check it in the before events
		modify( $d ) {
			setSum( $valDiscSum ),
			setOblSum( $valOblSum ),
			setVatSum( $vatAllSum )
		}
	} else {
		BigDecimal sum = $valDiscSum.add($e.getValueAll().multiply( (new BigDecimal( 100 )).subtract( $e.getDiscount() ).divide(new BigDecimal( 100 )) ).setScale(2, BigDecimal.ROUND_HALF_UP));
		BigDecimal oblSum = $valOblSum.add($e.getValueAll().multiply( (new BigDecimal( 100 )).subtract( $e.getDiscount() ).divide(new BigDecimal( 100 )) ));
		BigDecimal vatSum = $vatAllSum.add( $e.getVatAll() );
		modify( $d ) {
			setSum( sum ),
			setOblSum( oblSum ),
			setVatSum( vatSum )
		}
	}
	entitiesToBeSaved.add( $d );
end

rule CDeliveryDetailCalculate 
	salience 20
when
	$e: CDeliveryDetail(price != null && quantity != null && vat != null && discount != null)
then
	BigDecimal STO = new BigDecimal( 100 );
	BigDecimal discount = STO.subtract( $e.getDiscount() ).divide( STO );
	BigDecimal valuePrice = $e.getPrice().multiply( STO.add( $e.getVat() ).divide( STO )).setScale(2, BigDecimal.ROUND_HALF_UP);
	BigDecimal valueAll = $e.getQuantity().multiply( $e.getPrice() );
	BigDecimal valDisc = valueAll.multiply( discount ).setScale(2, BigDecimal.ROUND_HALF_UP);
	BigDecimal obl;
	if( $e.getVat().compareTo( BigDecimal.ZERO ) !=0 ){
		obl = valueAll.multiply( discount );
	} else {
		obl = BigDecimal.ZERO;
	}
	BigDecimal vatAll = valDisc.multiply( $e.getVat() ).divide(STO).setScale(2, BigDecimal.ROUND_HALF_UP);
	BigDecimal total = valDisc.add( vatAll );
	
	if( $e.getValuePrice() == null || $e.getValueAll() == null || $e.getTotal() == null || $e.getVatAll() == null
			|| $e.getValuePrice().compareTo( valuePrice ) != 0 || $e.getValueAll().compareTo( valueAll ) != 0 
			|| $e.getTotal().compareTo( total ) != 0 || $e.getVatAll().compareTo( vatAll ) != 0 
	) {
		modify( $e ) {
			setValuePrice( valuePrice ),
			setValueAll( valueAll ),
			setVatAll( vatAll ),
			setTotal( total )
		}
	}
end

rule CDeliveryDetailCostCalc when
	$e: CDeliveryDetail(deyId != null && deyId.costMethod != null && godId != null && quantity != null)
	not CDeliveryDetail(id == null && seeId != null) //don't activate when new service row is added - it is calculated in the other rule
	not CDeliveryDetail($e.id != null && id == null && godId != null) //don't activate when new goods row is added, which is not this row
	accumulate(
		$dd: CDeliveryDetail(id != $e.id, deleted != true, seeId != null, $vatAll: vatAll, $valueAll: valueAll, $discount: discount) from $e.deyId.deliveryDetails; 
		$serviceSum: sum($valueAll.multiply( (new BigDecimal( 100 )).subtract( $discount ).divide(new BigDecimal( 100 ), 2, RoundingMode.HALF_UP) ))
	)
	accumulate(
		CDeliveryDetail(id != $e.id, deleted != true, godId != null, quantity != null, $vatAll: vatAll, $valueAll: valueAll, $discount: discount, $quantity: quantity, $weight: godId.weight, $volume: godId.volume) from $e.deyId.deliveryDetails; 
		$totalValue: sum($valueAll.multiply( (new BigDecimal( 100 )).subtract( $discount ).divide(new BigDecimal( 100 ), 2, RoundingMode.HALF_UP) )),
		$totalQuantity: sum( $quantity ),
		$totalWeight: sum( $quantity.multiply( $weight ) ),
		$totalVolume: sum( $quantity.multiply( $volume ) )
	)
then
	//System.out.println("CDeliveryDetailCostCalc $serviceSum: "+$serviceSum+", $totalValue: "+$totalValue);
	BigDecimal totalValue = $e.isDeleted() ? $totalValue : $totalValue.add( $e.getValueAll().multiply( (new BigDecimal( 100 )).subtract( $e.getDiscount() ).divide(new BigDecimal( 100 ), 2, RoundingMode.HALF_UP) ) );
	BigDecimal[] costData = new BigDecimal[]{ BigDecimal.ONE /*out*/, BigDecimal.ZERO /*out*/ }; /*costBase out, newCost out*/;
	droolsRuleProcedures.calculateDeliveryCost( costData, $e, $serviceSum, totalValue, $totalQuantity.add( $e.getQuantity() ), $totalWeight.add( $e.getQuantity().multiply( $e.getGodId().getWeight() ) ), $totalVolume.add( $e.getQuantity().multiply( $e.getGodId().getVolume() ) ));
	if( $e.getCostBase().compareTo( costData[0] ) != 0 || $e.getCost().compareTo( costData[1] ) != 0 ) {
		CDeliveryDetail ddToSave = $e;
		modify( ddToSave ) {
			setCostBase( costData[0] ),
			setCost( costData[1] )
		}
		entitiesToBeSaved.add( ddToSave );
		//System.out.println("CDeliveryDetailCostCalc set "+ddToSave.getId()+" CostBase: "+costData[0]+", Cost: "+costData[1]);
	}
	for( CDeliveryDetail dd : $e.getDeyId().getDeliveryDetails() ) {
		if( dd.getGodId() != null ) {
			costData = new BigDecimal[]{ BigDecimal.ONE /*out*/, BigDecimal.ZERO /*out*/ }; /*costBase out, newCost out*/;
			droolsRuleProcedures.calculateDeliveryCost( costData, dd, $serviceSum, totalValue, $totalQuantity.add( $e.getQuantity() ), $totalWeight.add( $e.getQuantity().multiply( $e.getGodId().getWeight() ) ), $totalVolume.add( $e.getQuantity().multiply( $e.getGodId().getVolume() ) ));
			if( dd.getCostBase().compareTo( costData[0] ) != 0 || dd.getCost().compareTo( costData[1] ) != 0 ) {
				CDeliveryDetail ddToSave = dd;
				insert( ddToSave );
				modify( ddToSave ) {
					setCostBase( costData[0] ),
					setCost( costData[1] )
				}
				//System.out.println("CDeliveryDetailCostCalc set "+ddToSave.getId()+" CostBase: "+costData[0]+", Cost: "+costData[1]);
				entitiesToBeSaved.add( ddToSave );
			}
		}
	}
end

rule CDeliveryDetailOnServiceUpdateGoodsCostCalc when
	$e: CDeliveryDetail(deyId != null && seeId != null && quantity != null && price != null)
	accumulate(
		$dd: CDeliveryDetail(id != $e.id, deleted != true, seeId != null, $vatAll: vatAll, $valueAll: valueAll, $discount: discount) from $e.deyId.deliveryDetails; 
		$serviceSum: sum($valueAll.multiply( (new BigDecimal( 100 )).subtract( $discount ).divide(new BigDecimal( 100 ), 2, RoundingMode.HALF_UP) ))
	)
	accumulate(
		CDeliveryDetail(deleted != true, godId != null, quantity != null, $vatAll: vatAll, $valueAll: valueAll, $discount: discount, $quantity: quantity, $weight: godId.weight, $volume: godId.volume) from $e.deyId.deliveryDetails; 
		$totalValue: sum($valueAll.multiply( (new BigDecimal( 100 )).subtract( $discount ).divide(new BigDecimal( 100 ), 2, RoundingMode.HALF_UP) )),
		$totalQuantity: sum( $quantity ),
		$totalWeight: sum( $quantity.multiply( $weight ) ),
		$totalVolume: sum( $quantity.multiply( $volume ) )
	)
then
	BigDecimal serviceSum = $e.isDeleted() ? $serviceSum : $serviceSum.add( $e.getValueAll().multiply( (new BigDecimal( 100 )).subtract( $e.getDiscount() ).divide(new BigDecimal( 100 ), 2, RoundingMode.HALF_UP) ) );
	for( CDeliveryDetail dd : $e.getDeyId().getDeliveryDetails() ) {
		if( dd.getGodId() != null ) {
			BigDecimal[] costData = new BigDecimal[]{ BigDecimal.ONE /*out*/, BigDecimal.ZERO /*out*/ }; /*costBase out, newCost out*/;
			droolsRuleProcedures.calculateDeliveryCost( costData, dd, serviceSum, $totalValue, $totalQuantity, $totalWeight, $totalVolume);
			if( dd.getCostBase().compareTo( costData[0] ) != 0 || dd.getCost().compareTo( costData[1] ) != 0 ) {
				CDeliveryDetail ddToSave = dd;
				insert( ddToSave );
				modify( ddToSave ) {
					setCostBase( costData[0] ),
					setCost( costData[1] )
				}
				entitiesToBeSaved.add( ddToSave );
			}
		}
	}
end


