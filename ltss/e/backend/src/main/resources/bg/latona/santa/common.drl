rule CSaleExchangeRateNull
	salience -999
when
	$e: CSale(deleted == false && exchangeRate == null)
then
	warnings.rejectValue("CSale","exchangeRate","notNull",null);
end

rule CSaleExchangeRateDefault when
	$e: CSale(exchangeRate == null)
then
	BigDecimal newRate = BigDecimal.ONE;
	if( $e.getCurrency() != null ) {
		CPmtCurrencyRate pmtRate = droolsRuleProcedures.findCPmtCurrencyRateByCuyCodeAndDateFromLessThanEqualAndDateToGreaterThanEqualAndCompanyAndDeleted($e.getCurrency(), currentLocalDate, $e.getCompany(), false);
		if( pmtRate != null && pmtRate.getInMainCuy() != null && pmtRate.getUnitOfCuy() != null) {
			newRate = pmtRate.getInMainCuy().divide( new BigDecimal(pmtRate.getUnitOfCuy()) );
		}
	}
	modify( $e ) {
		setExchangeRate( newRate );
	}
end

rule CSaleExchangeRateChange when
	$e: CSale(exchangeRate != null)
	$old: CSale(exchangeRate != null && exchangeRate != $e.exchangeRate) from cleanEmWrapper.getOriginalEntity($e) //diff exchange rate
	$sd: CSaleDetail() from $e.saleDetails
then
	BigDecimal newPrice = $sd.getPrice().multiply($e.getExchangeRate()).divide($old.getExchangeRate(), 2, RoundingMode.HALF_UP);
	insert( $sd );
	modify( $sd ) {
		setPrice( newPrice ),
		setCurrency( $e.getCurrency() ),
		setRateExchange( $e.getExchangeRate() )
	}
	entitiesToBeSaved.add( $sd );
end

