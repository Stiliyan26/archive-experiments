rule COfferDetailStatusSA when
	$e: COfferDetail(company != null && ofrId != null && (ofrId.status != null && ofrId.status.listOptionItemCode == LoiOfferStatus.OFFER_STATUS_RA || ofrId.status != null && ofrId.status.listOptionItemCode == LoiOfferStatus.OFFER_STATUS_PI) && quantity == sdlQuantity && validationEvent.startsWith("afterSave"))
	not COfferDetail(quantity != sdlQuantity) from $e.ofrId.offerDetails
	$loiSA: LoiOfferStatus() from droolsRuleProcedures.findLoiOfferStatusByCodeAndCompanyAndDeleted(LoiOfferStatus.OFFER_STATUS_SA,$e.company,false)
then
	insert( $e.getOfrId() );
	modify( $e.getOfrId() ) {
		setStatus( $loiSA )
	}
	entitiesToBeSaved.add($e.getOfrId());
end

rule COfferDetailStatusRA when
	$e: COfferDetail(company != null && ofrId != null && ofrId.status != null && ofrId.status.listOptionItemCode == LoiOfferStatus.OFFER_STATUS_SA && quantity != sdlQuantity && validationEvent.startsWith("afterSave"))
	$loiRA: LoiOfferStatus() from droolsRuleProcedures.findLoiOfferStatusByCodeAndCompanyAndDeleted(LoiOfferStatus.OFFER_STATUS_RA,$e.company,false)
then
	insert( $e.getOfrId() );
	modify( $e.getOfrId() ) {
		setStatus( $loiRA )
	}
	entitiesToBeSaved.add($e.getOfrId());
end

rule COfferDetailDeleteReserveQuantities when
	$e: COfferDetail(company != null && ofrId != null && (ofrId.status != null && ofrId.status.listOptionItemCode == LoiOfferStatus.OFFER_STATUS_RA || ofrId.status != null && ofrId.status.listOptionItemCode == LoiOfferStatus.OFFER_STATUS_PI))
	$old: COfferDetail(quantity > 0 && 
		(godId != null && (deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete"))))
		|| ($e.godId != null && (godId != $e.godId || $e.quantity != quantity * droolsRuleProcedures.convertMeasures(meeId, $e.meeId)) && validationEvent.startsWith("afterSave"))
	) from cleanEmWrapper.getOriginalEntity($e)
	$rq: CReserveQuantity() from droolsRuleProcedures.findCReserveQuantityByOdlIdAndCompanyAndDeleted($e, $e.company, false)
then
	insert( $rq );
	modify( $rq ) {
		setDeleted( true )
	}
	entitiesToBeSaved.add($rq);
end

rule COfferCancelDeleteReserveQuantities when
	$e: COffer(status != null && status.listOptionItemCode == LoiOfferStatus.OFFER_STATUS_CA)
	$old: COffer(status == null || status.listOptionItemCode != LoiOfferStatus.OFFER_STATUS_CA) from cleanEmWrapper.getOriginalEntity($e)
	$od: COfferDetail() from $e.offerDetails
	$rq: CReserveQuantity(deleted != true) from $od.reserveQuantities
then
	insert( $rq );
	modify( $rq ) {
		setDeleted( true )
	}
	entitiesToBeSaved.add($rq);
end

rule COfferDetailCreateReserveQuantitiesForStock when
	$e: COfferDetail(company != null && godId != null && ofrId != null && (ofrId.status != null && ofrId.status.listOptionItemCode == LoiOfferStatus.OFFER_STATUS_RA || ofrId.status != null && ofrId.status.listOptionItemCode == LoiOfferStatus.OFFER_STATUS_PI))
	$old: COfferDetail(quantity > 0 && 
		($e.godId != null && ($e.id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeCreate")))
		|| ($e.godId != null && (godId != $e.godId || $e.quantity != quantity * droolsRuleProcedures.convertMeasures(meeId, $e.meeId)) && validationEvent.startsWith("afterSave"))
	) from cleanEmWrapper.getOriginalEntity($e)
	$s: CStock(deleted != true 
		&& (reserveQuantity == null || quantity > reserveQuantity)
		&& $e.quantity <= quantity.multiply( droolsRuleProcedures.convertMeasures($e.meeId, meeId) )
	) from droolsRuleProcedures.findCStockByGodIdAndOutCodeAndCompanyAndDeleted($e.godId, $e.ofrId.outCode, $e.company, false)
then
	BigDecimal coeff = droolsRuleProcedures.convertMeasures($e.getMeeId(), $s.getMeeId());
	BigDecimal calc = $e.getQuantity().multiply( coeff );
	if( $s.getQuantity().compareTo( calc.setScale(2, BigDecimal.ROUND_HALF_UP) ) < 0 ) {
		calc = $s.getQuantity();
	}
	List<CReserveQuantity> rqList = droolsRuleProcedures.findCReserveQuantityByOdlIdAndStkIdAndCompanyAndDeleted($e, $s, $e.getCompany(), false);
	CReserveQuantity rq = null;
	if( rqList.size() == 0 ) {
		rq = new CReserveQuantity(null, null, null, null, false, $e.getCompany(),
			calc.divide( coeff ),calc.divide( coeff ),$s,$e.getOfrId().getPartner(),null,$e.getOfrId().getEndDate(),$e.getOfrId(),$e.getGodId(),$e,$e.getMeeId(),null);
		insert( rq );
	} else {
		rq = rqList.get(0);
		insert( rq );
		modify( rq ){
			setInitialQuantity( calc.divide( coeff ) ),
			setQuantity( calc.divide( coeff ) ),
			setStkId( $s ),
			setPartner( $e.getOfrId().getPartner() ),
			setTerm( $e.getOfrId().getEndDate() ),
			setOfrId( $e.getOfrId() ),
			setGodId( $e.getGodId() ),
			setOdlId( $e ),
			setMeeId( $e.getMeeId() )
		}
	}
	entitiesToBeSaved.add(rq);
end

rule COfferDetailCreateReserveQuantitiesWithoutStock when
	$e: COfferDetail(company != null && godId != null && ofrId != null && (ofrId.status != null && ofrId.status.listOptionItemCode == LoiOfferStatus.OFFER_STATUS_RA || ofrId.status != null && ofrId.status.listOptionItemCode == LoiOfferStatus.OFFER_STATUS_PI))
	$old: COfferDetail(quantity > 0 && 
		($e.godId != null && ($e.id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeCreate")))
		|| ($e.godId != null && (godId != $e.godId || $e.quantity != quantity * droolsRuleProcedures.convertMeasures(meeId, $e.meeId)) && validationEvent.startsWith("afterSave"))
	) from cleanEmWrapper.getOriginalEntity($e)
	not $s: CStock(deleted != true 
		&& (reserveQuantity == null || quantity > reserveQuantity)
		&& $e.quantity <= quantity.multiply( droolsRuleProcedures.convertMeasures($e.meeId, meeId) )
	) from droolsRuleProcedures.findCStockByGodIdAndOutCodeAndCompanyAndDeleted($e.godId, $e.ofrId.outCode, $e.company, false)
then
	List<CReserveQuantity> rqList = droolsRuleProcedures.findCReserveQuantityByOdlIdAndStkIdAndCompanyAndDeleted($e, null, $e.getCompany(), false);
	CReserveQuantity rq = null;
	if( rqList.size() == 0 ) {
		rq = new CReserveQuantity(null, null, null, null, false, $e.getCompany(),
			$e.getQuantity(),BigDecimal.ZERO,null,$e.getOfrId().getPartner(),null,$e.getOfrId().getEndDate(),$e.getOfrId(),$e.getGodId(),$e,$e.getMeeId(),null);
		insert( rq );
	} else {
		rq = rqList.get(0);
		insert( rq );
		modify( rq ){
			setInitialQuantity( $e.getQuantity() ),
			setQuantity( BigDecimal.ZERO ),
			setStkId( null ),
			setPartner( $e.getOfrId().getPartner() ),
			setTerm( $e.getOfrId().getEndDate() ),
			setOfrId( $e.getOfrId() ),
			setGodId( $e.getGodId() ),
			setOdlId( $e ),
			setMeeId( $e.getMeeId() )
		}
	}
	entitiesToBeSaved.add(rq);
end

