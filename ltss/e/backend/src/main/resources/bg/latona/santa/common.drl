//CInvoice
rule CInvoiceIsIssued when
	$inv: CInvoice(id > 0 && validationEvent.startsWith("before") )
	$origInv: CInvoice(deleted == false && isIssued == true) from cleanEmWrapper.getOriginalEntity($inv)
then
	if($origInv != null) {
		$origInv.setIsExported(true); //only isExported is allowed to be set to true
		if(!$inv.equals($origInv)) {
			warnings.rejectValue($inv.getClass().getSimpleName(),"isIssued","invoiceNum.isIssued",$inv.getIsIssued());
		}
	}
end

rule CInvoiceInvoiceNumAutoinc when
	$inv: CInvoice(isIssued == true && invoiceNum == null && validationEvent.startsWith("before"))
then
	BigDecimal maxNum = droolsRuleProcedures.getInvoiceMaxIssuedCInvoiceInvoiceNum();
	BigDecimal newNum;
	if(maxNum == null) {
		newNum = BigDecimal.ONE;
	} else {
		newNum = maxNum.add(BigDecimal.ONE);
	}
	modify( $inv ) {
		setInvoiceNum( newNum );
	}
	warnings.add($inv.getClass().getName()+".invoiceNum default", false);
end

rule CInvoiceInvoiceNumNull
	salience -999
when
	$inv: CInvoice(deleted == false && isIssued == true && invoiceNum == null && validationEvent.startsWith("before"))
then
	warnings.rejectValue($inv.getClass().getSimpleName(),"invoiceNum","notNull",null);
end

rule CInvoiceInvoiceNumLast
	salience -999
when
	$inv: CInvoice(isIssued == true && invoiceNum != null && validationEvent.startsWith("before")
				&& invoiceNum != droolsRuleProcedures.getInvoiceMaxIssuedCInvoiceInvoiceNum().add(BigDecimal.ONE) )
	$origInv: CInvoice(deleted == false && (isIssued != true || invoiceNum == null)) from cleanEmWrapper.getOriginalEntity($inv)
then
	warnings.rejectValue($inv.getClass().getSimpleName(),"invoiceNum","invoiceNum.last",$inv.getInvoiceNum());
end

