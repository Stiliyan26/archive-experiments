rule FInvInvoiceInvNoAutoinc when
	$e: FInvInvoice(invNo == null && company != null && validationEvent.startsWith("before"))
then
	Long newLongNum = droolsRuleProcedures.getMaxAutoIncNum($e);
	Integer newNum = newLongNum == null ? null : Math.toIntExact(newLongNum);
	modify( $e ) {
		setInvNo( newNum );
	}
	warnings.add($e.getClass().getName()+".invNo default"+newNum, false);
end

