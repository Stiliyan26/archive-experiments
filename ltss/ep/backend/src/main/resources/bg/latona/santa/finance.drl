//set_post_date_out_code_pog
rule FPtJournalUpdateOutCodeFPtPosting when
	$e: FPtJournal(outCode != null && company != null && validationEvent.startsWith("beforeSave"))
	$old: FPtJournal(outCode != $e.outCode) from cleanEmWrapper.getOriginalEntity($e)
	$fpt: FPtPosting() from $e.fPtPostings
then
	insert( $fpt );
	modify( $fpt ){
		setOutCode($e.getOutCode())
	}
end

//set_post_date_in_postings
//set_post_date_out_code_pog
rule FPtJournalUpdatePostDateFPtPosting when
	$e: FPtJournal(postDate != null && company != null && validationEvent.startsWith("beforeSave"))
	$old: FPtJournal(postDate != $e.postDate) from cleanEmWrapper.getOriginalEntity($e)
	$fpt: FPtPosting() from $e.fPtPostings
then
	insert( $fpt );
	modify( $fpt ){
		setPostDate($e.getPostDate())
	}
end

//set_post_date_out_code_pog
rule FPtJournalCalculationFPtPostingAmount when
	$e: FPtJournal(deleted == false && company != null && validationEvent.startsWith("beforeSave"))
	$old: FPtJournal(status.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_C 
		&& ($e.status.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_C || $e.status.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_V) 
		&& (cuyCode != $e.cuyCode || cuyRate != $e.cuyRate || cuyUnit != $e.cuyUnit)) from cleanEmWrapper.getOriginalEntity($e)
	$fpt: FPtPosting() from $e.fPtPostings
then
	insert( $fpt );
	Integer intCuyUnit = $e.getCuyUnit();
	BigDecimal cuyUnit = BigDecimal.valueOf(intCuyUnit);
	BigDecimal round = $fpt.getAmountCurrency().multiply($e.getCuyRate().divide(cuyUnit)).setScale(2, BigDecimal.ROUND_HALF_UP);

	modify( $fpt ){
		setAmount(round)
	}
end

rule FPtJournalDisabledUpdate when
	$e: FPtJournal(deleted == false && company != null && validationEvent.startsWith("beforeSave"))
	FPtJournal(deleted == false && jteId!.type.listOptionItemCode != LoiJournalTypeCalculationType.JOURNAL_TYPE_CALCULATION_TYPE_E //Крайно салдо
			&& ! ( 
					(status.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_P || status.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_S) //Осчетоводен, Сторниран
					&& ccStatus.listOptionItemCode == LoiPtJournalCcStatus.PT_JOURNAL_CC_STATUS_P //Обработен
					&& bahId == $e.bahId 
					&& (postDate.month == $e.postDate.month && postDate.year == $e.postDate.year) 
					&& outCode == $e.outCode 
					&& status == $e.status 
					&& journalNo == $e.journalNo 
					&& stornoJolId == $e.stornoJolId 
					&& ccStatus == $e.ccStatus 
					&& cuyCode == $e.cuyCode 
					&& cuyRate == $e.cuyRate 
					&& cuyUnit == $e.cuyUnit 
					&& (jteId != $e.jteId && (jteId!.type == $e.jteId!.type) 
						|| descr != $e.descr 
						|| descr == $e.descr
					)
				)
			&& ! ! (status.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_P || status.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_S) //Осчетоводен, Сторниран
			&& ! (
				(status.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_P || status.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_S) //Осчетоводен, Сторниран
				&& ccStatus.listOptionItemCode == LoiPtJournalCcStatus.PT_JOURNAL_CC_STATUS_U //В процес на обработка
				&& $e.ccStatus.listOptionItemCode == LoiPtJournalCcStatus.PT_JOURNAL_CC_STATUS_P //Обработен
			)
			&& ! (
				status.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_P //Осчетоводен
				&& $e.status.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_S //Сторниран
				&& stornoJolId == null
			)
		) from cleanEmWrapper.getOriginalEntity($e)
then
	warnings.rejectValue("FPtJournal","code","cannotChangeJournal",null);
end

rule FPtJournalDisabledDelete when
	$e: FPtJournal(validationEvent.startsWith("beforeDelete") && company != null)
	$old: FPtJournal(deleted == false && (status!.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_P || status!.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_S)
		&& ccStatus.listOptionItemCode == LoiPtJournalCcStatus.PT_JOURNAL_CC_STATUS_P && jteId!.type!.listOptionItemCode != LoiJournalTypeCalculationType.JOURNAL_TYPE_CALCULATION_TYPE_E) from cleanEmWrapper.getOriginalEntity($e)
then
	warnings.rejectValue("FPtJournal","code","cannotChangeJournal",null);
end

//sql:select 'Не може да се редактира Счетоводна статия със статус Осчетоводен' from pt_journals jol where jol.status = 'P' and coalesce(<<jol.jol_tab_id>>,-1) = jol.id;";"validator - if status of jurnals is P do not change
rule FPtJournalNoChangeAfterPosting when
	$e: FPtJournal(id == triggerObject#CommonRecord.id && validationEvent.startsWith("before"))
	$old: FPtJournal(deleted == false && status!.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_P) from cleanEmWrapper.getOriginalEntity($e)
then
	warnings.rejectValue("FPtJournal","code","cannotChangeJournal",null);
end

