rule AllocationRecordUpdateAllocationProxy
	salience 999
when
	$e: AllocationRecord( allocatedQuantity != null )
	accumulate(
		//$ar: AllocationRecord( deleted == false, allocationConsumer == $e.allocationConsumer, $cId: id, $cQty: allocatedQuantity );
		$ar: AllocationRecord( deleted == false, allocationConsumer.id == $e.allocationConsumer.id, $cQty: allocatedQuantity );
		$sumConsumerQuantityCreated: sum( $cQty ),
		$consumerARInMemory: collectSet( $ar )
	)
	accumulate(
		//$ar: AllocationRecord( id not memberOf $consumerARInMemory && deleted == false, $cQty: allocatedQuantity ) from $e.allocationConsumer.consumerAllocationRecords;
		$ar: AllocationRecord( $ar not memberOf $consumerARInMemory && deleted == false, $cQty: allocatedQuantity ) from droolsRuleProcedures.findAllocationRecordByAllocationConsumerAndCompanyAndDeleted($e.allocationConsumer, $e.company, false);
		$sumConsumerQuantity: sum( $cQty )
	)
	accumulate(
		//$arp: AllocationRecord( deleted == false, allocationProducer == $e.allocationProducer, $pId: id, $pQty: allocatedQuantity );
		$arp: AllocationRecord( deleted == false, allocationProducer.id == $e.allocationProducer.id, $pQty: allocatedQuantity );
		$sumProducerQuantityCreated: sum( $pQty ),
		$producerARInMemory: collectSet( $arp )
	)
	accumulate(
		//$arp: AllocationRecord( id not memberOf $producerARInMemory && deleted == false, $pQty: allocatedQuantity ) from $e.allocationProducer.producerAllocationRecords;
		$arp: AllocationRecord( $arp not memberOf $producerARInMemory && deleted == false, $pQty: allocatedQuantity ) from droolsRuleProcedures.findAllocationRecordByAllocationConsumerAndCompanyAndDeleted($e.allocationProducer, $e.company, false);
		$sumProducerQuantity: sum( $pQty )
	)
then
	//System.out.println("AllocationRecordUpdateAllocationProxy sumConsumerQuantityCreated: "+$consumerARInMemory.size()+" "+$sumConsumerQuantityCreated+", sumConsumerQuantity: "+$sumConsumerQuantity+", sumProducerQuantityCreated: "+$producerARInMemory.size()+" "+$sumProducerQuantityCreated+", sumProducerQuantity: "+$sumProducerQuantity);
	BigDecimal newConsumerTotalAllocatedQuantity = $sumConsumerQuantity.add( $sumConsumerQuantityCreated );
	BigDecimal newProducerTotalAllocatedQuantity = $sumProducerQuantity.add( $sumProducerQuantityCreated );
	
	if( $e.getAllocationConsumer().getTotalAllocatedQuantity().compareTo( newConsumerTotalAllocatedQuantity ) != 0 ) {
		insert( $e.getAllocationConsumer() );
		if( $e.getAllocationConsumer().getQuantityToAllocate().compareTo(BigDecimal.ZERO) < 0 ) {
			modify( $e.getAllocationConsumer() ) {
				setTotalAllocatedQuantity( newConsumerTotalAllocatedQuantity )
			}
		} else {
			Boolean newFullyAllocated = ( newConsumerTotalAllocatedQuantity.compareTo( $e.getAllocationConsumer().getQuantityToAllocate() ) == 0 );
			modify( $e.getAllocationConsumer() ) {
				setTotalAllocatedQuantity( newConsumerTotalAllocatedQuantity ),
				setFullyAllocated( newFullyAllocated )
			}
		}
		entitiesToBeSaved.add( $e.getAllocationConsumer() );
	}

	if( $e.getAllocationProducer().getTotalAllocatedQuantity().compareTo( newProducerTotalAllocatedQuantity ) != 0 ) {
		insert( $e.getAllocationProducer() );
		if( $e.getAllocationProducer().getQuantityToAllocate().compareTo(BigDecimal.ZERO) < 0 ) {
			modify( $e.getAllocationProducer() ) {
				setTotalAllocatedQuantity( newProducerTotalAllocatedQuantity )
			}
		} else {
			Boolean newFullyAllocated = ( newProducerTotalAllocatedQuantity.compareTo( $e.getAllocationProducer().getQuantityToAllocate() ) == 0 );
			modify( $e.getAllocationProducer() ) {
				setTotalAllocatedQuantity( newProducerTotalAllocatedQuantity ),
				setFullyAllocated( newFullyAllocated )
			}
		}
		entitiesToBeSaved.add( $e.getAllocationProducer() );
	}
end

rule AllocationProxyUpdateConsumerAllocationRecordDelete
	salience 999
when 
	$e: AllocationProxy(validationEvent.startsWith("before"))
	$old: AllocationProxy(quantityToAllocate != $e.quantityToAllocate || allocationType != $e.allocationType || (deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))) from cleanEmWrapper.getOriginalEntity($e)
	$ar: AllocationRecord(deleted == false) from $e.consumerAllocationRecords
then
	insert( $ar );
	modify( $ar ){
		setDeleted( true )
	}
	entitiesToBeSaved.add( $ar );
end

rule AllocationProxyUpdateProducerAllocationRecordDelete
	salience 999
when 
	$e: AllocationProxy(validationEvent.startsWith("before"))
	$old: AllocationProxy(quantityToAllocate != $e.quantityToAllocate || allocationType != $e.allocationType || (deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))) from cleanEmWrapper.getOriginalEntity($e)
	$ar: AllocationRecord(deleted == false) from $e.producerAllocationRecords
then
	insert( $ar );
	modify( $ar ){
		setDeleted( true )
	}
	entitiesToBeSaved.add( $ar );
end


rule AllocationOriginCreateAllocationProxy
	salience 999
when
	$e: AllocationOrigin(company != null && deleted == false && validationEvent.startsWith("after"))
	$at: AllocationType() from droolsRuleProcedures.findAllocationTypeByProducerClassOrConsumerClassAndCompanyAndDeleted($e.getClass(), $e.company, false)
	not AllocationProxy() from droolsRuleProcedures.findAllocationProxyByAllocationOriginAndAllocationTypeAndCompanyAndDeleted( $e, $at, $e.company, false)
then
	AllocationProxy ap = new AllocationProxy(null, null, null, null, false, $e.getCompany(),
			$e, $at, $e.getQuantityToAllocate(), BigDecimal.ZERO, false);
	ap = (AllocationProxy) droolsRuleProcedures.save(ap); //save immediately to avoid the TransientObjectException
	insert( ap );
	//entitiesToBeSaved.add( ap );
end

rule AllocationOriginUpdateAllocationProxy
	salience 999
when
	$e: AllocationOrigin(id != null && company != null && deleted == false && validationEvent.startsWith("before"))
	$at: AllocationType() from droolsRuleProcedures.findAllocationTypeByProducerClassOrConsumerClassAndCompanyAndDeleted($e.getClass(), $e.company, false)
	$ap: AllocationProxy(quantityToAllocate != $e.getQuantityToAllocate()) from droolsRuleProcedures.findAllocationProxyByAllocationOriginAndAllocationTypeAndCompanyAndDeleted( $e, $at, $e.company, false)
then
	insert( $ap );
	modify( $ap ){
		setQuantityToAllocate( $e.getQuantityToAllocate() )
	}
	entitiesToBeSaved.add( $ap );
end

rule AllocationOriginDeleteFkAllocationProxy
	salience 999
when
	$e: AllocationOrigin(company != null && (deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete"))))
	$at: AllocationType() from droolsRuleProcedures.findAllocationTypeByProducerClassOrConsumerClassAndCompanyAndDeleted($e.getClass(), $e.company, false)
	$ap: AllocationProxy() from droolsRuleProcedures.findAllocationProxyByAllocationOriginAndAllocationTypeAndCompanyAndDeleted( $e, $at, $e.company, false)
then
	insert( $ap );
	modify( $ap ){
		setDeleted( true )
	}
	entitiesToBeSaved.add( $ap );
end


