rule COfferDetailLocked when
	$e: COfferDetail(id != null && sdlQuantity > 0 && validationEvent.startsWith("before"))
	$old: COfferDetail(godId != $e.godId || seeId != $e.seeId || meeId != $e.meeId || quantity != $e.quantity || price1 != $e.price1) from cleanEmWrapper.getOriginalEntity($e) //dateFrom was changed
then
	warnings.rejectValue("COfferDetail","sdlQuantity","OfferDetailIsLocked",$e.getSdlQuantity());
end

rule COfferDetailWrongQuantity when
	$e: COfferDetail(id != null && sdlQuantity > quantity && validationEvent.startsWith("before"))
then
	warnings.rejectValue("COfferDetail","sdlQuantity","SdlQuantityMoreThanQuantity",$e.getSdlQuantity());
end

rule COfferCalculateTotalFromDetails 
	salience 10
when
	$e: COfferDetail(price1 != null && quantity != null && discount != null && validationEvent.startsWith("before"))
	$o: COffer() from $e.ofrId
	accumulate(
		$od: COfferDetail(id != $e.id, deleted != true, $price1: price1, price1 != null, $quantity: quantity, quantity != null, $discount: discount, discount != null) from $o.offerDetails;
		$total: sum( ( $price1.multiply((new BigDecimal( 100 )).subtract( $discount ).divide((new BigDecimal( 100 ))))).multiply( $quantity ) )
	)
then
	insert( $o );
	if( ($e.isDeleted() == true || $e.getId() == ((CommonRecord)triggerObject).getId() && validationEvent.startsWith("beforeDelete")) ) { //"deleted" attribute becomes true in the "afterDelete" event - we can't check it in the before events
		modify( $o ) {
			setTotal( $total )
		}
	} else {
		BigDecimal total = $total.add( ( $e.getPrice1().multiply((new BigDecimal( 100 )).subtract( $e.getDiscount() ).divide((new BigDecimal( 100 ))))).multiply( $e.getQuantity() ) );
		modify( $o ) {
			setTotal( total )
		}
	}
	entitiesToBeSaved.add( $o );
end

rule COfferCalculateTotalWithDisc
	salience 0
when
	$e: COffer(discount != null && vat != null && total != null)
then
	BigDecimal STO = new BigDecimal( 100 );
	BigDecimal discount = STO.subtract( $e.getDiscount() ).divide( STO );
	BigDecimal vat = $e.getVat().divide( STO );
	BigDecimal totalWithDisc = $e.getTotal().multiply( discount );
	if( $e.getTotalWithDisc() == null || $e.getTotalWithDisc().compareTo( totalWithDisc ) != 0 ) {
		modify( $e ) {
			setTotalWithDisc( totalWithDisc )
		}
	}
end


