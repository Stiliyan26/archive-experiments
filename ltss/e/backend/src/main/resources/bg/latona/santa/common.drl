rule VendorInvoiceTaxBaseAmountFromVendorInvoiceRow
	salience 20 //before UpdateInvoiceTaxAmount
when
	$e: VendorInvoiceRow(quantity != null && quantity != 0 && priceRate != null && priceRate != 0 && invoice != null && validationEvent.startsWith("before"))
	accumulate(
		$rows: VendorInvoiceRow($quantity: quantity, $priceRate: priceRate, quantity != null, priceRate != null, deleted != true, id != $e.id) from $e.invoice.invoiceRows; 
		$sum: sum($quantity.multiply($priceRate).setScale(2, BigDecimal.ROUND_HALF_UP))
	)
then
	BigDecimal newValue = $sum.add($e.getQuantity().multiply($e.getPriceRate()).setScale(2, BigDecimal.ROUND_HALF_UP));
	if( $e.getInvoice().getTaxBaseAmount() == null || $e.getInvoice().getTaxBaseAmount().compareTo(newValue) != 0 ) {
		insert( $e.getInvoice() );
		modify( $e.getInvoice() ) {
			setTaxBaseAmount( newValue );
		}
		entitiesToBeSaved.add( $e.getInvoice() );
		warnings.add($e.getInvoice().getClass().getName()+".taxBaseAmount default", false);
	}
end

