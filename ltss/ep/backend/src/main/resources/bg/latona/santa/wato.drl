rule NewAttachableRevenuesAndExpensesFromImportedExpeditionListRow
when
	$expList: ImportedExpeditionListRow(id > 0, quantity != 0, orderRow != null, orderRow.offerLine != null, orderRow.offerLine.article != null, orderRow.offerLine.offerToClient != null)
	not AttachableRevenuesAndExpenses() from droolsRuleProcedures.findAttachableRevenuesAndExpensesByArticleAndAttachableAndCompanyAndDeleted($expList.orderRow.offerLine.article, $expList.orderRow.offerLine.offerToClient, $expList.company, false)
then
	AttachableRevenuesAndExpenses revExp = new AttachableRevenuesAndExpenses(null,null,null,null, false, $expList.getCompany(),
			$expList.getOrderRow().getOfferLine().getArticle(), 
			$expList.getQuantity().negate(), 
			$expList.getOrderRow().getOfferLine().getOfferToClient());
	insert( revExp );
	entitiesToBeSaved.add( revExp );
end

rule UpdateAttachableRevenuesAndExpensesFromImportedExpeditionListRow
when
	$expList: ImportedExpeditionListRow(id > 0, quantity != 0, orderRow != null, orderRow.offerLine != null, orderRow.offerLine.article != null, orderRow.offerLine.offerToClient != null)
	$revExp: AttachableRevenuesAndExpenses() from droolsRuleProcedures.findAttachableRevenuesAndExpensesByArticleAndAttachableAndCompanyAndDeleted($expList.orderRow.offerLine.article, $expList.orderRow.offerLine.offerToClient, $expList.company, false)
	accumulate(
		ImportedExpeditionListRow($quantity: quantity) from droolsRuleProcedures.findImportedExpeditionListRowByOrderRow($expList.orderRow); 
		$sum: sum($quantity)
	)
then
	$revExp.setAmmount( $sum );
	insert( $revExp );
	entitiesToBeSaved.add( $revExp );
end

rule NewAttachableRevenuesAndExpensesFromImportedInvoicePayment
when
	$pmnt: ImportedInvoicePayment(id > 0, totalPayed != 0, invoice != null, invoice.order != null, invoice.order.offer != null)
	$curr: Currency() from droolsRuleProcedures.findCurrencyByNameAndCompany("BGN", $pmnt.getCompany()) //TODO get correct currency for invoices
	not AttachableRevenuesAndExpenses() from droolsRuleProcedures.findAttachableRevenuesAndExpensesByArticleAndAttachableAndCompanyAndDeleted($curr, $pmnt.invoice.order.offer, $pmnt.company, false)
then
	AttachableRevenuesAndExpenses revExp = new AttachableRevenuesAndExpenses(null,null,null,null, false, $pmnt.getCompany(),
			$curr, 
			$pmnt.getTotalPayed(), 
			$pmnt.getInvoice().getOrder().getOffer());
	insert( revExp );
	entitiesToBeSaved.add( revExp );
end

rule UpdateAttachableRevenuesAndExpensesFromImportedInvoicePayment
when
	$pmnt: ImportedInvoicePayment(id > 0, totalPayed != 0, invoice != null, invoice.order != null, invoice.order.offer != null)
	$curr: Currency() from droolsRuleProcedures.findCurrencyByNameAndCompany("BGN", $pmnt.getCompany()) //TODO get correct currency for invoices
	$revExp: AttachableRevenuesAndExpenses() from droolsRuleProcedures.findAttachableRevenuesAndExpensesByArticleAndAttachableAndCompanyAndDeleted($curr, $pmnt.invoice.order.offer, $pmnt.company, false)
	accumulate(
		$inv: ImportedInvoice() from $pmnt.invoice.order.importedInvoices
		and ImportedInvoicePayment($totalPayed: totalPayed) from $inv.importedInvoicePayments; 
		$sum: sum($totalPayed)
	)
then
	$revExp.setAmmount( $sum );
	insert( $revExp );
	entitiesToBeSaved.add( $revExp );
end

rule ImportedOrderRowFkImportedInvoiceRow
	salience -999
when
	$e: ImportedOrderRow(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$fk: ImportedInvoiceRow(deleted == false) from $e.importedInvoiceRows
then
	warnings.rejectValue("ImportedOrderRow","deleted","fkDenyDelete",$fk);
end

