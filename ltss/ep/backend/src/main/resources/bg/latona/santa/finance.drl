//delete_posting
rule FPtPostingsDeleteCheck
	salience -999
when
	$e: FPtPosting(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete"))
			&& (jolId == null 
				|| jolId.status!.listOptionItemCode != LoiPtJournalStatus.PT_JOURNAL_STATUS_C
				|| coaStatus!.listOptionItemCode != LoiPtPostingCoaStatus.PT_POSTING_COA_STATUS_U
			)
		)
then
	warnings.rejectValue("FPtPosting","deleted","cannotChangeJournal",null);
end

rule FPtPostingInsertFPtJournalOutCodeAndPostDate when
	$fpt: FPtPosting(jolId != null  && validationEvent.startsWith("beforeCreate") && company != null )
	$jol: FPtJournal(outCode != null && postDate != null) from $fpt.jolId
then
	modify($fpt){
		setOutCode($jol.getOutCode()),
		setPostDate($jol.getPostDate())
	}
end

rule FPtPostingPostDateUpdateDisable when
	$e: FPtPosting(validationEvent.startsWith("beforeSave") && company != null)
	$old: FPtPosting(deleted == false && (jolId!.status!.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_P || jolId!.status!.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_S) //Осчетоводен, Сторниран
		&& jolId!.ccStatus!.listOptionItemCode == LoiPtJournalCcStatus.PT_JOURNAL_CC_STATUS_P //Обработен
		&& jolId!.jteId!.type.listOptionItemCode != LoiJournalTypeCalculationType.JOURNAL_TYPE_CALCULATION_TYPE_E //Крайно салдо
		&& (postDate.month != $e.postDate.month || postDate.year != $e.postDate.year)) from cleanEmWrapper.getOriginalEntity($e)
then
	warnings.rejectValue("FPtPosting","postDate","cannotChangeJournal",$old);
end

rule FPtPostingPostDateDeleteDisable when
	$e: FPtPosting(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$old: FPtPosting(deleted == false && (jolId!.status!.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_P || jolId!.status!.listOptionItemCode == LoiPtJournalStatus.PT_JOURNAL_STATUS_S) //Осчетоводен, Сторниран
		&& jolId!.ccStatus!.listOptionItemCode == LoiPtJournalCcStatus.PT_JOURNAL_CC_STATUS_P //Обработен
		&& jolId!.jteId!.type.listOptionItemCode != LoiJournalTypeCalculationType.JOURNAL_TYPE_CALCULATION_TYPE_E //Крайно салдо
	) from cleanEmWrapper.getOriginalEntity($e)
then
	warnings.rejectValue("FPtPosting","deleted","cannotChangeJournal",$e);
end

