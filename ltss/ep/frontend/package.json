{
	"name": "santa-team-cube",
	"private": true,
	"version": "0.1.104",
	"description": "Santa Capital manager",
	"hostURL": "https://127.0.0.1:8443",
	"main": "src/client.js",
	"scripts": {
		"clean": "rimraf dist/*",
		"copy": "copyfiles -f ./src/index.html ./dist && copyfiles -u 1 \"./src/static/**\" ./dist",
		"lint": "eslint ./src",
		"posttest": "npm run lint",
		"release:major": "npm version prerelease && git push --follow-tags && npm publish --tag beta",
		"release:minor": "npm version prerelease && git push --follow-tags && npm publish --tag beta",
		"release:patch": "npm version prerelease && git push --follow-tags && npm publish --tag beta",
		"test": "cross-env NODE_ENV=test karma start",
		"test:watch": "cross-env NODE_ENV=test karma start --autoWatch=true --singleRun=false --reporters=mocha,coverage",
		"dev": "babel-node ./src/server.js",
		"dev-linux": "nohub babel-node ./src/server.js &",
		"dist": "babel-node ./src/server.js --env dist",
		"express-debug": "set DEBUG=express:* && babel-node ./src/server.js --display-error-details --logger",
		"express-dev": "babel-node ./src/server.js",
		"demo-build": "npm run clean && npm run copy && webpack --progress --env demo",
		"test_bgmashini-build": "npm run clean && npm run copy && webpack --progress --env testBgMashini",
		"staging-build": "npm run clean && npm run copy && webpack --progress --env staging",
		"dist-build": "npm run clean && npm run copy && webpack --progress --env dist",
		"dist_bgmashini-build": "npm run clean && npm run copy && webpack --progress --env distBgMashini",
		"dist_nepal-build": "npm run clean && npm run copy && webpack --progress --env distNepal",
		"test_selfie-build": "npm run clean && npm run copy && webpack --progress --env testSelfie",
		"test_anvoice-build": "npm run clean && npm run copy && webpack --progress --env testAnvoice",
		"dist-stats": "webpack --json --progress --env dist > stats.json",
		"build-docker-image": "npm install && npm run dist-build && docker build -t ivandonov/santa-credit ."
	},
	"repository": "",
	"keywords": [],
	"author": "Ivan Andonov ivan.andonov@latona.bg",
