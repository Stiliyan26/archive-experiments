rule FInvInvoiceSalePeriodDefault when
	$e: FInvInvoice(salePeriod == null)
then
	String defaultSalePeriod = currentLocalDate.getMonth() + "" + currentLocalDate.getYear();

	modify( $e ) {
		setSalePeriod(defaultSalePeriod);
	}
end

