rule RemoveDeletedMailAccountFromWaitingSendMailMessages
	salience -999
when
	$account: MailAccount(deleted == true, validationEvent.startsWith("after"))
	$mail: SendMailMessage(sent == false) from droolsRuleProcedures.findSendMailMessageByFromAccount($account)
then
	$mail.setFromAccount( null );
	entitiesToBeSaved.add($mail);
	insert( $mail );
	warnings.add("SendMailMessage.fromAccount cleared", false);
end

rule SetDefaultMailAccountToWaitingSendMailMessages
when
	$account: MailAccount(id != null, deleted == false, defaultAccount == true)
	$mail: SendMailMessage() from droolsRuleProcedures.findSendMailMessageByFromAccount(null)
then
	$mail.setFromAccount( $account );
	entitiesToBeSaved.add($mail);
	insert( $mail );
	warnings.add("SendMailMessage.fromAccount default", false);
end

