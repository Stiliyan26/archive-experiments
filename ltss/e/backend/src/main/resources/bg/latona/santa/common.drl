rule CBlockedQuantityNotEnoughQuantityToBlock when
	$e: CBlockedQuantity(deleted == false && quantity > 0 && stkId != null && stkId.quantity.subtract(stkId.blockedQuantity) < quantity && validationEvent.startsWith("before"))
then
	warnings.rejectValue("CBlockedQuantity","quantity","notEnoughQuantityToBlock",$e.getQuantity());
end

rule CBlockedQuantityNotEnoughQuantityToUnblock when
	$e: CBlockedQuantity(deleted == false && quantity < 0 && stkId != null && stkId.blockedQuantity != null && stkId.blockedQuantity < -quantity && validationEvent.startsWith("before"))
then
	modify($e) {
		setQuantity( $e.getStkId().getBlockedQuantity().negate() )
	}
	warnings.add("notEnoughQuantityToUnblock",false);
	warnings.rejectValue("CBlockedQuantity","quantity","notEnoughQuantityToUnblock",$e.getQuantity());
end

rule CStockBlockedQuantityFromBlockedQuantity 
	salience 10
when
	$e: CBlockedQuantity(quantity != null && validationEvent.startsWith("before"))
	$s: CStock() from $e.stkId
	accumulate(
		$bq: CBlockedQuantity(id != $e.id, deleted != true, $quantity: quantity) from $s.blockedQuantities; 
		$quantitySum: sum($quantity)
	)
then
	insert( $s );
	if( ($e.isDeleted() == true || $e.getId() == ((CommonRecord)triggerObject).getId() && validationEvent.startsWith("beforeDelete")) ) { //"deleted" attribute becomes true in the "afterDelete" event - we can't check it in the before events
		modify( $s ) {
			setBlockedQuantity( $quantitySum )
		}
	} else {
		BigDecimal sum = $quantitySum.add( $e.getQuantity() );
		modify( $s ) {
			setBlockedQuantity( sum )
		}
	}
	entitiesToBeSaved.add( $s );
end


