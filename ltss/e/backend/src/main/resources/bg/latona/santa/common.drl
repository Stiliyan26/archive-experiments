rule CStockCalculateReserveQuantityFromCReserveQuantities 
	salience 10
when
	$e: CReserveQuantity(meeId != null && validationEvent.startsWith("before"))
	$s: CStock(deleted != true && meeId != null) from $e.stkId
	$coeff: BigDecimal() from droolsRuleProcedures.convertMeasures($e.meeId, $s.meeId)
	accumulate(
		$rq: CReserveQuantity(deleted == false && stkId == $s, $rqId: id, $quantity: quantity);
		$sumInMemory: sum($quantity.multiply($coeff)),
		$reserveQuantityInMemory: collectSet( $rqId )
	)
	accumulate(
		$rq: CReserveQuantity(id not memberOf $reserveQuantityInMemory, $quantity: quantity) from droolsRuleProcedures.findCReserveQuantityByStkIdAndCompanyAndDeleted($s, $s.company, false);
		$sum: sum($quantity.multiply($coeff))
	)
then
	//System.out.println("CStockCalculateReserveQuantityFromCReserveQuantities CReserveQuantity "+$e.getId()+", CStock "+$s.getId()+" in memory "+$sumInMemory+" in DB "+$sum+" with exch.rate "+$coeff);
	if( ($e.isDeleted() || $e.getId() == ((CommonRecord)triggerObject).getId() && validationEvent.startsWith("beforeDelete")) && $s.getReserveQuantity().compareTo($sum) != 0 ) { //"deleted" attribute becomes true in the "afterDelete" event - we can't check it in the before events
		insert( $s );
		modify( $s ) {
			setReserveQuantity( $sum )
		}
		entitiesToBeSaved.add( $s );
	} else {
		BigDecimal reserveQuantity = $sum.add( $sumInMemory );
		if( $s.getReserveQuantity().compareTo(reserveQuantity) != 0 ) {
			insert( $s );
			modify( $s ) {
				setReserveQuantity( reserveQuantity )
			}
			entitiesToBeSaved.add( $s );
		}
	}
	//System.out.println("CStockCalculateReserveQuantityFromCReserveQuantities CStock.reserveQuantity set to "+$s.getReserveQuantity());
end


