rule CGoodMarkChangeDefaultVendor when
	$e: CGoodMark(defaultVendor != null)
	$old: CGoodMark(defaultVendor != $e.defaultVendor) from cleanEmWrapper.getOriginalEntity($e)
	$g: CGoods(defaultVendor == null || defaultVendor == $old.defaultVendor) from $e.markGoods
then
	insert( $g );
	modify( $g ) {
		setDefaultVendor($e.getDefaultVendor())
	}
	entitiesToBeSaved.add( $g );
end


