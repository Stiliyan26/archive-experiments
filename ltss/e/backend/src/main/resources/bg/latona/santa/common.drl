rule CSaleDetailDeleteStockQuantitySubtract when
	$e: CSaleDetail(saeId != null && saeId.typeDoc != null && saeId.typeDoc.listOptionItemCode == LoiTypeDoc.TYPE_DOC_KI && (deleted == true || id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$old: CSaleDetail(deleted == false && meeId != null && stkId != null && stkId.meeId != null) from cleanEmWrapper.getOriginalEntity($e)
then
	BigDecimal quantity = Optional.ofNullable($old.getStkId().getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal oldQuantity = Optional.ofNullable($old.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal coef2 = $old.getStkId().getMeeId().getCofficient().divide( $old.getMeeId().getCofficient() );
	BigDecimal newQuantity = quantity.subtract( oldQuantity.multiply( coef2 ) );
	insert( $old.getStkId() );
	modify( $old.getStkId() ) {
		setQuantity( newQuantity )
	}
	entitiesToBeSaved.add( $old.getStkId() );
end

//grasp.modify_sdl(),grasp.modify_stocks ==> stock.quantity = ddl.quantity - sdl.quantity???
rule CSaleDetailDeleteStockQuantityAdd when
	$e: CSaleDetail(saeId != null && saeId.typeDoc != null && saeId.typeDoc.listOptionItemCode != LoiTypeDoc.TYPE_DOC_KI && (deleted == true || id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$old: CSaleDetail(deleted == false && meeId != null && stkId != null && stkId.meeId != null) from cleanEmWrapper.getOriginalEntity($e)
then
	BigDecimal quantity = Optional.ofNullable($old.getStkId().getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal oldQuantity = Optional.ofNullable($old.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal coef2 = $old.getStkId().getMeeId().getCofficient().divide( $old.getMeeId().getCofficient() );
	BigDecimal newQuantity = quantity.add( oldQuantity.multiply( coef2 ) );
	insert( $old.getStkId() );
	modify( $old.getStkId() ) {
		setQuantity( newQuantity )
	}
	entitiesToBeSaved.add( $old.getStkId() );
end

rule CSaleDetailDeleteOfferDetailSdlQuantity when
	$e: CSaleDetail(saeId != null && saeId.typeDoc != null && saeId.typeDoc.listOptionItemCode != LoiTypeDoc.TYPE_DOC_KI && (deleted == true || id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$old: CSaleDetail(deleted == false && odlId != null && meeId != null && odlId.meeId != null) from cleanEmWrapper.getOriginalEntity($e)
then
	BigDecimal sdlQuantity = Optional.ofNullable($old.getOdlId().getSdlQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal oldQuantity = Optional.ofNullable($old.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal newSdlQuantity = sdlQuantity.subtract( oldQuantity.multiply( droolsRuleProcedures.convertMeasures($old.getMeeId(), $old.getOdlId().getMeeId()) ) );
	//System.out.println("CSaleDetailDeleteOfferDetailSdlQuantity old sdlQty "+sdlQuantity+", subtracting "+oldQuantity+", new sdlQty "+newSdlQuantity);
	insert( $old.getOdlId() );
	modify( $old.getOdlId() ) {
		setSdlQuantity( newSdlQuantity )
	}
	entitiesToBeSaved.add( $old.getOdlId() );
end

rule CSaleDetailDeleteReserveQuantityQuantity when
	$e: CSaleDetail(saeId != null && saeId.typeDoc != null && saeId.typeDoc.listOptionItemCode != LoiTypeDoc.TYPE_DOC_KI && company != null && (deleted == true || id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$old: CSaleDetail(deleted == false && odlId != null && meeId != null && stkId != null) from cleanEmWrapper.getOriginalEntity($e)
	$rq: CReserveQuantity(meeId != null) from droolsRuleProcedures.findCReserveQuantityByOdlIdAndStkIdAndCompanyAndDeleted($old.odlId, $old.stkId, $e.company, false)
then
	BigDecimal quantity = Optional.ofNullable($rq.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal oldQuantity = Optional.ofNullable($old.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal newQuantity = quantity.add( oldQuantity.multiply( droolsRuleProcedures.convertMeasures($old.getMeeId(), $rq.getMeeId()) ) ); 
	insert( $rq );
	modify( $rq ) {
		setQuantity( newQuantity )
	}
	entitiesToBeSaved.add( $rq );
end

rule CSaleDetailInsertStockQuantityKiCheck when
	$e: CSaleDetail(saeId != null && saeId.typeDoc != null && saeId.typeDoc.listOptionItemCode == LoiTypeDoc.TYPE_DOC_KI && validationEvent.startsWith("beforeCreate")
		 && meeId != null && stkId != null && stkId.meeId != null && sdlId != null)
	accumulate(
		CSaleDetail(quantity != null, $sdlQuantity: quantity) from $e.sdlId.saleDetails;
		$sum: sum($sdlQuantity)
	)
then
	BigDecimal curs1col = $e.getSdlId().getQuantity().subtract( $sum );
	BigDecimal oldQuantity = Optional.ofNullable($e.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal calc = oldQuantity.multiply( $e.getStkId().getMeeId().getCofficient() ).divide( $e.getMeeId().getCofficient() );
	if( curs1col.compareTo( calc ) < 0 ) {
		warnings.rejectValue("CSaleDetail","sdlId","Невъзможно действие! Количество за връщане -->",curs1col); 
	}
end

rule CSaleDetailInsertStockQuantityAdd when
	$e: CSaleDetail(saeId != null && saeId.typeDoc != null && saeId.typeDoc.listOptionItemCode == LoiTypeDoc.TYPE_DOC_KI && validationEvent.startsWith("beforeCreate")
		 && meeId != null && stkId != null && stkId.meeId != null)
then
	BigDecimal quantity = Optional.ofNullable($e.getStkId().getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal oldQuantity = Optional.ofNullable($e.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal calc = oldQuantity.multiply( $e.getStkId().getMeeId().getCofficient() ).divide( $e.getMeeId().getCofficient() );
	BigDecimal newQuantity = quantity.add( calc );
	insert( $e.getStkId() );
	modify( $e.getStkId() ) {
		setQuantity( newQuantity )
	}
	entitiesToBeSaved.add( $e.getStkId() );
end

rule CSaleDetailInsertStockQuantityCheck when
	$e: CSaleDetail(saeId != null && saeId.typeDoc != null && saeId.typeDoc.listOptionItemCode != LoiTypeDoc.TYPE_DOC_KI && validationEvent.startsWith("beforeCreate")
		 && meeId != null && stkId != null && stkId.meeId != null)
then
	BigDecimal cursQuantity = $e.getStkId().getQuantity();
	if( $e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_SR) || $e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_PP) ) {
		cursQuantity = cursQuantity.subtract( $e.getStkId().getBlockedQuantity() );
	}
	BigDecimal oldQuantity = Optional.ofNullable($e.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal calc = oldQuantity.multiply( $e.getStkId().getMeeId().getCofficient() ).divide( $e.getMeeId().getCofficient() );
	if( cursQuantity.compareTo( calc ) < 0 ) {
		warnings.rejectValue("CSaleDetail","sdlId","Недостатъчно количество! Налично количество --> %, За изписване --> % ",cursQuantity); 
	}
end

rule CSaleDetailInsertStockQuantitySubtract when
	$e: CSaleDetail(saeId != null && saeId.typeDoc != null && saeId.typeDoc.listOptionItemCode != LoiTypeDoc.TYPE_DOC_KI && validationEvent.startsWith("beforeCreate")
		 && meeId != null && stkId != null && stkId.meeId != null)
then
	BigDecimal quantity = Optional.ofNullable($e.getStkId().getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal oldQuantity = Optional.ofNullable($e.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal calc = oldQuantity.multiply( $e.getStkId().getMeeId().getCofficient() ).divide( $e.getMeeId().getCofficient() );
	BigDecimal newQuantity = quantity.subtract( calc );
	insert( $e.getStkId() );
	modify( $e.getStkId() ) {
		setQuantity( newQuantity )
	}
	entitiesToBeSaved.add( $e.getStkId() );
end

rule CSaleDetailInsertOfferDetailSdlQuantity when
	$e: CSaleDetail(saeId != null && saeId.typeDoc != null && saeId.typeDoc.listOptionItemCode != LoiTypeDoc.TYPE_DOC_KI && validationEvent.startsWith("beforeCreate")
		&& odlId != null && meeId != null && odlId.meeId != null)
then
	BigDecimal sdlQuantity = Optional.ofNullable($e.getOdlId().getSdlQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal oldQuantity = Optional.ofNullable($e.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal newSdlQuantity = sdlQuantity.add( oldQuantity.multiply( droolsRuleProcedures.convertMeasures($e.getMeeId(), $e.getOdlId().getMeeId()) ) );
	//System.out.println("CSaleDetailInsertOfferDetailSdlQuantity old sdlQty "+sdlQuantity+", adding "+oldQuantity+", new sdlQty "+newSdlQuantity);
	insert( $e.getOdlId() );
	modify( $e.getOdlId() ) {
		setSdlQuantity( newSdlQuantity )
	}
	entitiesToBeSaved.add( $e.getOdlId() );
end

rule CSaleDetailInsertReserveQuantityQuantity when
	$e: CSaleDetail(saeId != null && saeId.typeDoc != null && saeId.typeDoc.listOptionItemCode != LoiTypeDoc.TYPE_DOC_KI && company != null && validationEvent.startsWith("beforeCreate")
		&& odlId != null && meeId != null && stkId != null)
	$rq: CReserveQuantity(meeId != null) from droolsRuleProcedures.findCReserveQuantityByOdlIdAndStkIdAndCompanyAndDeleted($e.odlId, $e.stkId, $e.company, false)
	$coeff: BigDecimal() from droolsRuleProcedures.convertMeasures($e.getMeeId(), $rq.getMeeId())
	accumulate(
		$sd: CSaleDetail(deleted == false && odlId == $e.odlId && stkId == $e.stkId && quantity != null, $sdId: id, $quantity: quantity);
		$sumInMemory: sum($quantity.multiply($coeff)),
		$sdQuantityInMemory: collectSet( $sdId )
	)
	accumulate(
		$sd: CSaleDetail(id not memberOf $sdQuantityInMemory, $quantity: quantity) from droolsRuleProcedures.findCSaleDetailByOdlIdAndStkIdAndCompanyAndDeleted($e.odlId, $e.stkId, $e.company, false);
		$sum: sum($quantity.multiply($coeff))
	)
then
	BigDecimal soldQuantity = $sum.add($sumInMemory);
	BigDecimal newQuantity = $rq.getInitialQuantity().subtract( soldQuantity );
	//System.out.println("CSaleDetailInsertReserveQuantityQuantity sets qty to "+newQuantity+" = initQty "+$rq.getInitialQuantity()+" - sold qty in memory "+$sumInMemory+" - sold qty in DB "+$sum);
	insert( $rq );
	modify( $rq ) {
		setQuantity( newQuantity )
	}
	entitiesToBeSaved.add( $rq );
end

rule CSaleDetailUpdateCheck when
	$e: CSaleDetail(saeId != null && validationEvent.startsWith("beforeSave")
		&& stkId != null && stkId.meeId != null && sdlId != null)
	$old: CSaleDetail(deleted == false && meeId != null && stkId != null) from cleanEmWrapper.getOriginalEntity($e)
	accumulate(
		CSaleDetail(quantity != null, $sdlQuantity: quantity) from $e.sdlId.saleDetails;
		$sum: sum($sdlQuantity)
	)
then
	BigDecimal curs1kol = $e.getSdlId().getQuantity().subtract( $sum );
	BigDecimal coef = $e.getStkId().getMeeId().getCofficient().divide( $e.getMeeId().getCofficient() );
	BigDecimal coef2 = $e.getStkId().getMeeId().getCofficient().divide( $old.getMeeId().getCofficient() );
	BigDecimal newQuantity = Optional.ofNullable($e.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal oldQuantity = Optional.ofNullable($old.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal delta = newQuantity.multiply( coef ).subtract( oldQuantity.multiply( coef2 ) );
	if( $e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_KI) ) {
		if( $e.getStkId().equals($old.getStkId()) ) {
			if( curs1kol.compareTo( delta ) < 0 ) {
				warnings.rejectValue("CSaleDetail","stkId","Невъзможно действие! Количество за връщане --> %",curs1kol);
			}
		}
	}
end

rule CSaleDetailUpdate when
	$e: CSaleDetail(saeId != null && validationEvent.startsWith("beforeSave")
		&& stkId != null && stkId.meeId != null)
	$old: CSaleDetail(deleted == false && meeId != null && stkId != null) from cleanEmWrapper.getOriginalEntity($e)
then
	BigDecimal cursQuantity = $e.getStkId().getQuantity();
	if( $e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_SR) || $e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_PP) ) {
		cursQuantity = cursQuantity.subtract( $e.getStkId().getBlockedQuantity() );
	}
	BigDecimal coef = $e.getStkId().getMeeId().getCofficient().divide( $e.getMeeId().getCofficient() );
	BigDecimal coef2 = $e.getStkId().getMeeId().getCofficient().divide( $old.getMeeId().getCofficient() );
	
	BigDecimal newQuantity = Optional.ofNullable($e.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal oldQuantity = Optional.ofNullable($old.getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal newStockQuantity = Optional.ofNullable($e.getStkId().getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal oldStockQuantity = Optional.ofNullable($old.getStkId().getQuantity()).orElse(BigDecimal.ZERO);
	BigDecimal delta = newQuantity.multiply( coef ).subtract( oldQuantity.multiply( coef2 ) );
	if( $e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_KI) ) {
		if( $e.getStkId().equals($old.getStkId()) ) {
			if( cursQuantity.compareTo( delta ) < 0 ) {
				warnings.rejectValue("CSaleDetail","stkId","Недостатъчно количество! Налично --> %, За изписване --> %",cursQuantity);
			} else if( delta.compareTo( BigDecimal.ZERO ) != 0 ) {
				insert( $e.getStkId() );
				modify( $e.getStkId() ) {
					setQuantity( newStockQuantity.add( delta ) )
				}
				entitiesToBeSaved.add( $e.getStkId() );
			}
		} else if( cursQuantity.compareTo( newQuantity.multiply( coef ) ) < 0 ) {
			warnings.rejectValue("CSaleDetail","stkId","Недостатъчно количество! Налично количество --> %, За изписване --> %",cursQuantity);
		} else {
			insert( $old.getStkId() );
			modify( $old.getStkId() ) {
				setQuantity( newStockQuantity.add( oldQuantity.multiply( coef2 ) ) )
			}
			entitiesToBeSaved.add( $old.getStkId() );
			
			insert( $e.getStkId() );
			modify( $e.getStkId() ) {
				setQuantity( newStockQuantity.add( newQuantity.multiply( coef ) ) )
			}
			entitiesToBeSaved.add( $e.getStkId() );
		}
	} else if( $e.getStkId().equals( $old.getStkId() ) ) {
		if( cursQuantity.compareTo( delta ) < 0 ) {
			warnings.rejectValue("CSaleDetail","stkId","Недостатъчно количество! Налично --> %, За изписване --> %",cursQuantity);
		} else if( delta.compareTo( BigDecimal.ZERO ) != 0 ) {
			if( $e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_PB) || $e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_DI) ) {
				BigDecimal vCalc = $e.getStkId().getBlockedQuantity();
				if( vCalc.compareTo( delta ) > 0 ) {
					vCalc = delta;
				}
				if( vCalc.compareTo( BigDecimal.ZERO ) != 0 ) {
					CBlock newBlock = new CBlock(null, null, null, null, false, $e.getCompany(), 
						($e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_PB) ? "PB" : "DI"), null, "Промяна в количеството за "+($e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_PB) ? "бракуване" : "връщане"), $e.getSaeId().getOutCode());
					insert( newBlock );
					entitiesToBeSaved.add( newBlock );
					
					CBlockedQuantity newBlockedQuantity = new CBlockedQuantity(null, null, null, null, false, $e.getCompany(), 
						vCalc.negate(), $e.getStkId(), newBlock, null, null);
					insert( newBlockedQuantity );
					entitiesToBeSaved.add( newBlockedQuantity );
				}
			}
			if( $e.getOdlId() == null ) {
				insert( $e.getStkId() );
				modify( $e.getStkId() ) {
					setQuantity( newStockQuantity.subtract( delta ) )
				}
				entitiesToBeSaved.add( $e.getStkId() );
			} else {
				BigDecimal sdlQuantity = Optional.ofNullable($e.getOdlId().getSdlQuantity()).orElse(BigDecimal.ZERO);
				insert( $e.getOdlId() );
				modify( $e.getOdlId() ) {
					setSdlQuantity( sdlQuantity
						.add( newQuantity.multiply( droolsRuleProcedures.convertMeasures($e.getMeeId(), $e.getOdlId().getMeeId()) ) )
						.subtract( oldQuantity.multiply( droolsRuleProcedures.convertMeasures($old.getMeeId(), $e.getOdlId().getMeeId()) ) )
					)
				}
				entitiesToBeSaved.add( $e.getOdlId() );
				
				insert( $e.getStkId() );
				modify( $e.getStkId() ) {
					setQuantity( newStockQuantity.subtract( delta ) )
				}
				entitiesToBeSaved.add( $e.getStkId() );
				
				List<CReserveQuantity> rqList = droolsRuleProcedures.findCReserveQuantityByOdlIdAndStkIdAndCompanyAndDeleted($e.getOdlId(), $e.getStkId(), $e.getCompany(), false);
				for(CReserveQuantity rqItem: rqList) {
					CReserveQuantity rq = rqItem;
					BigDecimal rqQuantity = Optional.ofNullable(rq.getQuantity()).orElse(BigDecimal.ZERO);
					insert( rq );
					modify( rq ) {
						setQuantity( rqQuantity
							.subtract( newQuantity.multiply( droolsRuleProcedures.convertMeasures($e.getMeeId(), rq.getMeeId()) ) )
							.add( oldQuantity.multiply( droolsRuleProcedures.convertMeasures($old.getMeeId(), rq.getMeeId()) ) )
						)
					}
					entitiesToBeSaved.add( rq );
				}
			}
		}
	} else {
		if( cursQuantity.compareTo( newQuantity.multiply( coef ) ) < 0 ) {
			warnings.rejectValue("CSaleDetail","stkId","Недостатъчно количество! Налично количество --> %, За изписване --> %",cursQuantity);
		} else {
			if( $e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_PB) || $e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_DI) ) { //при бракуване или връщане на диставчик
				BigDecimal vCalc = $old.getStkId().getBlockedQuantity();
				CBlock newBlock = null;
				if( vCalc.compareTo( oldQuantity.negate().multiply( coef2 ) ) > 0 ) { //с предимство от вече блокираното количество (но не задължително)
					vCalc = oldQuantity.negate().multiply( coef2 );
				}
				if( vCalc.compareTo( BigDecimal.ZERO ) != 0 ) {
					newBlock = new CBlock(null, null, null, null, false, $e.getCompany(), 
						($e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_PB) ? "PB" : "DI"), null, "Промяна в наличността за "+($e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_PB) ? "бракуване" : "връщане"), $e.getSaeId().getOutCode());
					insert( newBlock );
					entitiesToBeSaved.add( newBlock );
					
					CBlockedQuantity newBlockedQuantity = new CBlockedQuantity(null, null, null, null, false, $e.getCompany(), 
						vCalc.negate(), $old.getStkId(), newBlock, null, null);
					insert( newBlockedQuantity );
					entitiesToBeSaved.add( newBlockedQuantity );
				}
				
				vCalc = $e.getStkId().getBlockedQuantity();
				if( vCalc.compareTo( newQuantity.multiply( coef2 ) ) > 0 ) { //с предимство от вече блокираното количество (но не задължително)
					vCalc = newQuantity.multiply( coef2 );
				}
				if( vCalc.compareTo( BigDecimal.ZERO ) != 0 ) {
					if( newBlock == null ) {
						newBlock = new CBlock(null, null, null, null, false, $e.getCompany(), 
							($e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_PB) ? "PB" : "DI"), null, "Промяна в наличността за "+($e.getSaeId().getTypeDoc().getListOptionItemCode().equals(LoiTypeDoc.TYPE_DOC_PB) ? "бракуване" : "връщане"), $e.getSaeId().getOutCode());
						insert( newBlock );
						entitiesToBeSaved.add( newBlock );
					}
					
					CBlockedQuantity newBlockedQuantity = new CBlockedQuantity(null, null, null, null, false, $e.getCompany(), 
						vCalc.negate(), $e.getStkId(), newBlock, null, null);
					insert( newBlockedQuantity );
					entitiesToBeSaved.add( newBlockedQuantity );
				}
			}
			
			if( $old.getOdlId() == null ) {
				insert( $old.getStkId() );
				modify( $old.getStkId() ) {
					setQuantity( oldStockQuantity.add( $old.getQuantity().multiply( coef2 ) ) )
				}
				entitiesToBeSaved.add( $old.getStkId() );
			} else {
				BigDecimal sdlQuantity = Optional.ofNullable($old.getOdlId().getSdlQuantity()).orElse(BigDecimal.ZERO);
				insert( $old.getOdlId() );
				modify( $old.getOdlId() ) {
					setSdlQuantity( sdlQuantity
						.subtract( oldQuantity.multiply( droolsRuleProcedures.convertMeasures($old.getMeeId(), $old.getOdlId().getMeeId()) ) )
					)
				}
				entitiesToBeSaved.add( $old.getOdlId() );
				
				insert( $old.getStkId() );
				modify( $old.getStkId() ) {
					setQuantity( oldStockQuantity.add( $old.getQuantity().multiply( coef2 ) ) )
				}
				entitiesToBeSaved.add( $old.getStkId() );
				
				List<CReserveQuantity> rqList = droolsRuleProcedures.findCReserveQuantityByOdlIdAndStkIdAndCompanyAndDeleted($old.getOdlId(), $old.getStkId(), $e.getCompany(), false);
				for(CReserveQuantity rqItem: rqList) {
					CReserveQuantity rq = rqItem;
					BigDecimal rqQuantity = Optional.ofNullable(rq.getQuantity()).orElse(BigDecimal.ZERO);
					insert( rq );
					modify( rq ) {
						setQuantity( rqQuantity
							.add( oldQuantity.multiply( droolsRuleProcedures.convertMeasures($old.getMeeId(), rq.getMeeId()) ) )
						)
					}
					entitiesToBeSaved.add( rq );
				}
			}
			
			if( $e.getOdlId() == null ) {
				insert( $e.getStkId() );
				modify( $e.getStkId() ) {
					setQuantity( newStockQuantity.subtract( newQuantity.multiply( coef ) ) )
				}
				entitiesToBeSaved.add( $e.getStkId() );
			} else {
				BigDecimal sdlQuantity = Optional.ofNullable($e.getOdlId().getSdlQuantity()).orElse(BigDecimal.ZERO);
				insert( $e.getOdlId() );
				modify( $e.getOdlId() ) {
					setSdlQuantity( sdlQuantity
						.add( newQuantity.multiply( droolsRuleProcedures.convertMeasures($e.getMeeId(), $e.getOdlId().getMeeId()) ) )
					)
				}
				entitiesToBeSaved.add( $e.getOdlId() );
				
				insert( $e.getStkId() );
				modify( $e.getStkId() ) {
					setQuantity( newStockQuantity.subtract( newQuantity.multiply( coef ) ) )
				}
				entitiesToBeSaved.add( $e.getStkId() );
				
				List<CReserveQuantity> rqList = droolsRuleProcedures.findCReserveQuantityByOdlIdAndStkIdAndCompanyAndDeleted($e.getOdlId(), $e.getStkId(), $e.getCompany(), false);
				for(CReserveQuantity rqItem: rqList) {
					CReserveQuantity rq = rqItem;
					BigDecimal rqQuantity = Optional.ofNullable(rq.getQuantity()).orElse(BigDecimal.ZERO);
					insert( rq );
					modify( rq ) {
						setQuantity( rqQuantity
							.subtract( newQuantity.multiply( droolsRuleProcedures.convertMeasures($e.getMeeId(), rq.getMeeId()) ) )
						)
					}
					entitiesToBeSaved.add( rq );
				}
			}
		}
	}
end


rule LoiGoodsTypeFkCCcGoodsType
	salience -999
when
	$e: LoiGoodsType(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$fk: CCcGoodsType(deleted == false) from $e.cCcGoodsTypes
then
	warnings.rejectValue("LoiGoodsType","deleted","fkDenyDelete",$fk);
end

rule LoiGoodsTypeFkCGoods
	salience -999
when
	$e: LoiGoodsType(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$fk: CGoods(deleted == false) from $e.cGoods
then
	warnings.rejectValue("LoiGoodsType","deleted","fkDenyDelete",$fk);
end


