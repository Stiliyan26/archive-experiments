rule TransportFkInvoiceRow
	salience -999
when
	$e: Transport(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$fk: InvoiceRow(deleted == false) from $e.invoiceRows
then
	warnings.rejectValue("Transport","deleted","fkDenyDelete",$fk);
end

