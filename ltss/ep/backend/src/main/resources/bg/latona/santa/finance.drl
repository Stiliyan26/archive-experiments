rule FChartAccountCurrencyDefault when
	$e: FChartAccount(currency == null)
	$cuyCode: CCtCurrency() from droolsRuleProcedures.findCCtCurrencyByCodeAndCompanyAndDeleted("BGN", $e.company, false)
then
	modify( $e ) {
		setCurrency($cuyCode);
	}
end

