	$e: FPtJournal(journalNo == null)
then
	//misc.get_next_number_no_year (extract(year from new.post_date)::varchar, 'JOL', new.out_code,'N');
	Long newLongNum = droolsRuleProcedures.getMaxAutoIncNum($e);
	Integer newNum = newLongNum == null ? null : Math.toIntExact(newLongNum);
	modify( $e ) {
		setJournalNo( newNum );
	}
	warnings.add($e.getClass().getName()+".journalNo default"+newNum, false);
end

