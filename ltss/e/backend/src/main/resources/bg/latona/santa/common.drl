	BigDecimal newValue = taxRate.multiply($e.getTaxBaseAmount()).setScale(2, BigDecimal.ROUND_HALF_UP);
	if( $e.getTaxAmount() == null || $e.getTaxAmount().compareTo(newValue) != 0 ) {
