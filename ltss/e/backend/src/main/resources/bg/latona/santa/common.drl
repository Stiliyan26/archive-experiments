rule COfferNumberOfrAutoinc when
	$e: COffer(numberOfr == null && company != null && validationEvent.startsWith("before"))
then
	Long newLongNum = droolsRuleProcedures.getMaxAutoIncNum($e);
	Integer newNum = newLongNum == null ? null : Math.toIntExact(newLongNum);
	modify( $e ) {
		setNumberOfr( newNum );
	}
	warnings.add($e.getClass().getName()+".numberOfr default"+newNum, false);
end

