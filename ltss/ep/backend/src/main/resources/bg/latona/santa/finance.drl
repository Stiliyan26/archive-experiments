when
	$e: FCcProgram(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$fk: FHpCcBalance(deleted == false) from $e.fHpCcBalances
then
	warnings.rejectValue("FCcProgram","deleted","fkDenyDelete",$fk);
end

