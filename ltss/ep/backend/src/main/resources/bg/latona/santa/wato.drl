//waste

rule WasteCostCenterFkWaste
	salience -999
when
	$e: WasteCostCenter(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$fk: Waste(deleted == false) from $e.wastes
then
	warnings.rejectValue("WasteCostCenter","deleted","fkDenyDelete",$fk);
end

rule WasteTypeFkWaste
	salience -999
when
	$e: WasteType(
	deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$k: Waste(deleted == false) from $e.wastes
then
	warnings.rejectValue("WasteType","deleted","fkDenyDelete",$k);
end

rule WasteKindFkWasteType
	salience -999
when
	$e: WasteKind(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$fk: WasteType(deleted == false) from $e.wasteTypes
then
	warnings.rejectValue("WasteKind","deleted","fkDenyDelete",$fk);
end

//importing rules
rule NewLegalPersonFromImportedSantaPartner
when
	$isp: ImportedSantaPartner(legalPerson == null)
	not LegalPerson(company == $isp.company) from droolsRuleProcedures.findLegalPersonByEik( $isp.bulstat )
	$ls: LegalStatus() from droolsRuleProcedures.findLegalStatusByCodeAndCompany(
			$isp.legalStatusId == "BJT" ? 1L : ($isp.legalStatusId == "BJN" ? 2L : ($isp.legalStatusId == "BN" ? 3L : ($isp.legalStatusId == "ORJ" ? 4L : ($isp.legalStatusId == "ORN" ? 5L : 6L)))),
			$isp.company )
then
	LegalPerson legalPerson = new LegalPerson(null,null,null,null, false, $isp.getCompany(),
			$isp.getName() == null ? "-няма-" : $isp.getName(), 
			$isp.getBulstat() == null ? "-няма-" : $isp.getBulstat(), 
			$isp.getEgn() == null ? "-няма-" : $isp.getEgn(), 
			$isp.getBulstat() == null ? "-няма-" : $isp.getBulstat(), 
			$isp.getMol() == null ? "-няма-" : $isp.getMol(), 
			$isp.getAddress() == null ? "-няма-" : $isp.getAddress(), 
			"-няма-", 
			$isp.getAddress() == null ? "-няма-" : $isp.getAddress(), 
			"-няма-", null, $ls, null);
	entitiesToBeSaved.add(legalPerson);
	insert( legalPerson );
	$isp.setLegalPerson( legalPerson );
	entitiesToBeSaved.add($isp);
	update( $isp );
	warnings.add("ImportedSantaPartner automatic import to LegalPerson: "+$isp.getId()+"; "+$isp.getName()+"; "+$isp.getBulstat(), false);
end

rule ExistingLegalPersonToImportedSantaPartner
when
	$isp: ImportedSantaPartner(legalPerson == null)
	$lp: LegalPerson(company == $isp.company) from droolsRuleProcedures.findLegalPersonByEik( $isp.bulstat )
then
	modify( $isp ) {
		setLegalPerson( $lp );
	}
	entitiesToBeSaved.add( $isp );
	warnings.add("ImportedSantaPartner automatic import to existing LegalPerson", false);
end

rule UpdateLegalPersonFromImportedSantaPartner
when
	$isp: ImportedSantaPartner(legalPerson != null
		&& (name != null && name != legalPerson.name
			|| bulstat != null && bulstat != legalPerson.eik
			|| egn != null && egn != legalPerson.egn
			|| mol != null && mol != legalPerson.mol
			|| address != null && address != legalPerson.address
			|| address != null && address != legalPerson.currentAddress
		)
	)
then
	LegalPerson legalPerson = $isp.getLegalPerson();
	if($isp.getName() != null) legalPerson.setName($isp.getName());
	if($isp.getBulstat() != null) legalPerson.setEik($isp.getBulstat());
	if($isp.getBulstat() != null) legalPerson.setVatNumber($isp.getBulstat());
	if($isp.getEgn() != null) legalPerson.setEgn($isp.getEgn());
	if($isp.getMol() != null) legalPerson.setMol($isp.getMol());
	if($isp.getAddress() != null) legalPerson.setAddress($isp.getAddress());
	if($isp.getAddress() != null) legalPerson.setCurrentAddress($isp.getAddress());
	entitiesToBeSaved.add( legalPerson );
	insert( legalPerson );
	warnings.add("ImportedSantaPartner automatic update of LegalPerson", false);
end

rule UpdateLegalPersonLegalStatusFromImportedSantaPartner
when
	$isp: ImportedSantaPartner(legalPerson != null && legalStatusId != null)
	$ls: LegalStatus(code != $isp.legalPerson.legalStatus.code, company == $isp.company) from droolsRuleProcedures.findLegalStatusByCodeAndCompany(
			$isp.legalStatusId == "BJT" ? 1L : ($isp.legalStatusId == "BJN" ? 2L : ($isp.legalStatusId == "BN" ? 3L : ($isp.legalStatusId == "ORJ" ? 4L : ($isp.legalStatusId == "ORN" ? 5L : 6L)))),
			$isp.company )
then
	LegalPerson legalPerson = $isp.getLegalPerson();
	legalPerson.setLegalStatus($ls);
	entitiesToBeSaved.add( legalPerson );
	insert( legalPerson );
	warnings.add("ImportedSantaPartner automatic update of LegalPerson's LegalStatus", false);
end

rule NewLegalPersonContactFromImportedSantaPartner
when
	$isp: ImportedSantaPartner(legalPerson != null)
	not Contact(type.code == ContactType.CONTACT_TYPE_GENERAL) from droolsRuleProcedures.findContactByPerson($isp.legalPerson)
	$ct: ContactType() from droolsRuleProcedures.findContactTypeByCodeAndCompany(ContactType.CONTACT_TYPE_GENERAL,$isp.company)
then
	Contact contact = new Contact(null,null,null,null, false, $isp.getCompany(),
		null, null, $isp.getPhone(), null, $isp.getEmail(), null, $isp.getLegalPerson(), $ct);
	entitiesToBeSaved.add(contact);
	insert( contact );
	warnings.add("ImportedSantaPartner automatic import of LegalPerson's Contact", false);
end

rule UpdateLegalPersonContactFromImportedSantaPartner
when
	$isp: ImportedSantaPartner(legalPerson != null)
	$con: Contact(type.code == ContactType.CONTACT_TYPE_GENERAL, $isp.phone != phone || $isp.email != email) from droolsRuleProcedures.findContactByPerson($isp.legalPerson)
then
	if($isp.getPhone() != null) $con.setPhone($isp.getPhone());
	if($isp.getEmail() != null) $con.setEmail($isp.getEmail());
	entitiesToBeSaved.add( $con );
	insert( $con );
	warnings.add("ImportedSantaPartner automatic update of LegalPerson's Contact", false);
end


rule NewLegalPersonFromImportedLegalPerson
when
	$isp: ImportedLegalPerson(legalPerson == null)
	not LegalPerson(
					!(vatNumber == "999999999999999" || vatNumber == null || vatNumber == "")
					|| (vatNumber == "999999999999999" || vatNumber == null || vatNumber == "") && name == $isp.companyName
				) from droolsRuleProcedures.findLegalPersonByVatNumberAndCompany($isp.vatNumber, $isp.company)
	$ls: LegalStatus() from droolsRuleProcedures.findLegalStatusByCodeAndCompany( $isp.clName == "Юридическо лице" ? 1L : 6L, $isp.company )
then
	LegalPerson legalPerson = new LegalPerson(null,null,null,null, false, $isp.getCompany(),
			$isp.getCompanyName() == null || $isp.getCompanyName().length()==0 ? "-няма-" : $isp.getCompanyName(), 
			$isp.getBulstat() == null || $isp.getBulstat().length()==0 ? "-няма-" : $isp.getBulstat(), 
			$isp.getBulstat() == null || $isp.getBulstat().length()==0 ? "-няма-" : $isp.getBulstat(), 
			$isp.getVatNumber() == null || $isp.getVatNumber().length()==0 ? "-няма-" : $isp.getVatNumber(), 
			$isp.getMolName() == null || $isp.getMolName().length()==0 ? "-няма-" : $isp.getMolName(), 
			$isp.getRegAddress() == null || $isp.getRegAddress().length()==0 ? "-няма-" : $isp.getRegAddress(), 
			"-няма-", 
			($isp.getCurrCountry() == null ? "" : $isp.getCurrCountry()+", ")
			+($isp.getCurrCity() == null ? "" : $isp.getCurrCity()+", ")
			+$isp.getCurrAddress(), 
			$isp.getRegCountry() == null || $isp.getRegCountry().length()==0 ? "-няма-" : $isp.getRegCountry(), 
			$isp.getRegCity() == null || $isp.getRegCity().length()==0 ? "-няма-" : $isp.getRegCity(), 
			$ls, null);
	entitiesToBeSaved.add(legalPerson);
	insert( legalPerson );
	$isp.setLegalPerson( legalPerson );
	entitiesToBeSaved.add($isp);
	update( $isp );
	warnings.add("ImportedLegalPerson automatic import to LegalPerson", false);
end

rule ExistingLegalPersonToImportedLegalPerson
when
	$isp: ImportedLegalPerson(legalPerson == null)
	$lp: LegalPerson(
					!(vatNumber == "999999999999999" || vatNumber == null || vatNumber == "")
					|| (vatNumber == "999999999999999" || vatNumber == null || vatNumber == "") && name == $isp.companyName
				) from droolsRuleProcedures.findLegalPersonByVatNumberAndCompany($isp.vatNumber, $isp.company)
then
	modify( $isp ) {
		setLegalPerson( $lp );
	}
	entitiesToBeSaved.add( $isp );
	warnings.add("ImportedLegalPerson automatic import to existing LegalPerson", false);
end

rule UpdateLegalPersonFromImportedLegalPerson
when
	$isp: ImportedLegalPerson(legalPerson != null
		&& (companyName != null && $isp.companyName.length()>0 && companyName != legalPerson.name
			|| vatNumber != null && $isp.vatNumber.length()>0 && vatNumber != legalPerson.vatNumber
			|| bulstat != null && $isp.bulstat.length()>0 && bulstat != legalPerson.eik
			|| bulstat != null && $isp.bulstat.length()>0 && bulstat != legalPerson.egn
			|| molName != null && $isp.molName.length()>0 && molName != legalPerson.mol
			|| regAddress != null && $isp.regAddress.length()>0 && regAddress != legalPerson.address
			|| currAddress != null && $isp.currAddress.length()>0 
				&& ($isp.currCountry == null ? "" : $isp.currCountry+", ")
				+($isp.currCity == null ? "" : $isp.currCity+", ")
				+$isp.currAddress != legalPerson.currentAddress
			|| regCountry != null && $isp.regCountry.length()>0 && regCountry != legalPerson.country
			|| regCity != null && $isp.regCity.length()>0 && regCity != legalPerson.city
		)
	)
then
	LegalPerson legalPerson = $isp.getLegalPerson();
	if($isp.getCompanyName() != null && $isp.getCompanyName().length()>0) legalPerson.setName($isp.getCompanyName());
	if($isp.getBulstat() != null && $isp.getBulstat().length()>0) legalPerson.setEik($isp.getBulstat());
	if($isp.getBulstat() != null && $isp.getBulstat().length()>0) legalPerson.setEgn($isp.getBulstat());
	if($isp.getVatNumber() != null && $isp.getVatNumber().length()>0) legalPerson.setVatNumber($isp.getVatNumber());
	if($isp.getMolName() != null && $isp.getMolName().length()>0) legalPerson.setMol($isp.getMolName());
	if($isp.getRegAddress() != null && $isp.getRegAddress().length()>0) legalPerson.setAddress($isp.getRegAddress());
	if($isp.getCurrAddress() != null && $isp.getCurrAddress().length()>0) legalPerson.setCurrentAddress(
			($isp.getCurrCountry() == null ? "" : $isp.getCurrCountry()+", ")
			+($isp.getCurrCity() == null ? "" : $isp.getCurrCity()+", ")
			+$isp.getCurrAddress()
		);
	if($isp.getRegCountry() != null && $isp.getRegCountry().length()>0) legalPerson.setCountry($isp.getRegCountry());
	if($isp.getRegCity() != null && $isp.getRegCity().length()>0) legalPerson.setCity($isp.getRegCity());
	entitiesToBeSaved.add( legalPerson );
	insert( legalPerson );
	warnings.add("ImportedLegalPerson automatic update of LegalPerson", false);
end

