rule CommonRecordCalculateOnlyFail
	salience -9999
when
	$cr: CommonRecord(calculateOnly == true)
then
	warnings.rejectValue("CommonRecord","calculateOnly","calculateOnly.calculateOnly",$cr);
end

rule CommonRecordCreatedDateDefault 
	salience 999
when
	$cr: CommonRecord(createdDate == null || id == null && createdDate != currentDate)
then
	modify( $cr ) {
		setCreatedDate( currentDate );
	}
	warnings.add($cr.getClass().getName()+".createdDate default", false);
end

rule CommonRecordCreatedByDefault 
	salience 999
when
	$cr: CommonRecord(createdBy == null || id == null && createdBy != currentUser)
then
	modify( $cr ) {
		setCreatedBy( currentUser );
	}
	warnings.add($cr.getClass().getName()+".createdBy default", false);
end

rule CommonRecordLastModifiedDateDefault 
	salience 999
when
	$cr: CommonRecord(validationEvent.startsWith("before"))
then
	modify( $cr ) {
		setLastModifiedDate( currentDate );
	}
	//warnings.add($cr.getClass().getName()+".lastModifiedDate default", false);
end

rule CommonRecordLastModifiedByDefault 
	salience 999
when
	$cr: CommonRecord(validationEvent.startsWith("before"))
then
	modify( $cr ) {
		setLastModifiedBy( currentUser );
	}
	//warnings.add($cr.getClass().getName()+".lastModifiedBy default", false);
end

//deleted flag is set only in the "after" events, so here we try to cover it for the "before" events
rule CompanyRecordDeletedSet 
	salience 999
when
	$cr: CompanyRecord(deleted == false && id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete"))
then
	modify( $cr ) {
		setDeleted( true );
	}
	warnings.add($cr.getClass().getName()+".deleted", true);
end


rule CompanyRecordCompanyDefault 
	salience 999
when
	$cr: CompanyRecord(company == null)
then
	modify( $cr ) {
		setCompany( currentUser.getCompany() );
	}
	warnings.add($cr.getClass().getName()+".company "+currentUser.getCompany().getName()+" of user "+currentUser.getName(), false);
end


rule SecUserNameNull 
	salience -999
when
	$su: SecUser(deleted == false && (name == null || name.length() == 0 || name.trim().isEmpty()))
then
	warnings.rejectValue("SecUser","name","name.notNull",null);
end


//TODO Do we need to check the working memory for uniqueness too?
//UNIQUE check rules
rule UniqueCommonRecord
	salience -999
when
	$new: CommonRecord(deleted == false)
	$old: CommonRecord(id != $new.id) from droolsRuleProcedures.checkForUniqueCommonRecord($new, false)
then
	warnings.rejectValue($new.getClass().getSimpleName(),"uniqueness","notUnique",$old);
end

rule UniqueCommonRecordUndelete
	salience -999
when
	$new: CommonRecord(id == null)
	$old: CommonRecord() from droolsRuleProcedures.checkForUniqueCommonRecord($new, true)
then
	$new.setId($old.getId());
	warnings.add("Undeleting "+$new.getClass().getSimpleName()+" with id: "+$old.getId(), false);
end

