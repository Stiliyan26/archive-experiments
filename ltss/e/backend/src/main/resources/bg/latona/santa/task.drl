rule LegalPersonFkInvoice
	salience -999
when
	$e: LegalPerson(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$fk: Invoice(deleted == false) from $e.invoices
then
	warnings.rejectValue("LegalPerson","deleted","fkDenyDelete",$fk);
end

