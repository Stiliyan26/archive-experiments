rule CPmtCurrencyRateOrganizationUnitDefault when
	$e: CPmtCurrencyRate(outCode == null && company != null)
	$ou: CCcOrganizationUnit() from droolsRuleProcedures.findCCcOrganizationUnitByCodeAndCompanyAndDeleted("01", $e.company, false)
then
	modify( $e ) {
		setOutCode( $ou );
	}
end

