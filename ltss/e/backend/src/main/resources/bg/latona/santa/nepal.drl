rule ScheduleIsSentValidation
	salience -999
when
 	 $e: Schedule(deleted == false && isSent == true && validationEvent.startsWith("beforeSave"))
 	 $old: Schedule(deleted == false && isSent == true && messageVersion == $e.messageVersion) from cleanEmWrapper.getOriginalEntity($e)
then
	warnings.rejectValue("Schedule","isSent","scheduleIsSent",null);
end

rule PowerPlantProfileDefaultCreatingQuarterOfHours
	salience -999
when
 	 $e: PowerPlantProfile(deleted == false && validationEvent.startsWith("afterCreate"))
then
	for(int i = 1; i < 97; i++) {
	  QuarterOfHour quarterOfHour = new QuarterOfHour();
	  quarterOfHour.setQuarterOfHour(BigDecimal.valueOf(i));
	  quarterOfHour.setValue(BigDecimal.ZERO);
	  quarterOfHour.setPowerPlantProfile($e);

	  insert(quarterOfHour);
	  entitiesToBeSaved.add(quarterOfHour);
	}
end

rule QuarterOfHourDeletedUpdate when
 	 $e: PowerPlantProfile(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
 	 $fk: QuarterOfHour(deleted == false) from $e.quarterOfHours
then
	insert($fk);
	modify($fk){
		setDeleted(true);
	}
	entitiesToBeSaved.add( $fk );
end

