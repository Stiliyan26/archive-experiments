rule FPtBatchCuyRateNull
	salience -999
when
	$su: FPtBatch(deleted == false && cuyRate == null)
then
	warnings.rejectValue("FPtBatch","cuyRate","notNull",null);
end

rule FPtBatchCuyRateDefault when
	$e: FPtBatch(company != null && cuyCode != null)
then
	BigDecimal newRate = BigDecimal.ONE;
	if( $e.getCuyCode() != null ) {
		CPmtCurrencyRate pmtRate = droolsRuleProcedures.findCPmtCurrencyRateByCuyCodeAndDateFromLessThanEqualAndDateToGreaterThanEqualAndCompanyAndDeleted($e.getCuyCode(), currentLocalDate, $e.getCompany(), false);
		if( pmtRate != null && pmtRate.getInMainCuy() != null && pmtRate.getUnitOfCuy() != null) {
			newRate = pmtRate.getInMainCuy().divide( new BigDecimal(pmtRate.getUnitOfCuy()) );
			if($e.getCuyRate() == null || newRate.compareTo($e.getCuyRate()) != 0) {
				modify( $e ) {
					setCuyRate(newRate),
					setCuyUnit(pmtRate.getUnitOfCuy())
				}
			}
		}
	}
	if($e.getCuyRate() == null || newRate.compareTo($e.getCuyRate()) != 0) {
		modify( $e ) {
			setCuyRate(newRate)
		}
	}
end

