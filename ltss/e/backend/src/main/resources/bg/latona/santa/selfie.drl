rule PowerPlantCreatingRelationWithImportValue
	salience -999
when
 	 $e: PowerPlant(deleted == false && validationEvent.startsWith("afterCreate"))
then
	ImportValue importValue = droolsRuleProcedures.findImportValueByReportingPointOwnAndCompanyAndDeleted($e.getAccessPoint(), $e.getCompany(), false);
	if (importValue != null) {

		insert(importValue);
		importValue.setPowerPlant($e);
		entitiesToBeSaved.add(importValue);
	}
end

