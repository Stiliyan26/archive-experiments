then
	warnings.rejectValue("FChartAccount","dateOpened","notNull",null);
end

rule FChartAccountDateOpenedDefault when
	$e: FChartAccount(dateOpened == null)
then
	modify( $e ) {
		setDateOpened(currentLocalDate)
	}
end

rule FChartAccountDateClosedNull 
	salience -999
when
	$su: FChartAccount(deleted == false && dateClosed == null)
then
	warnings.rejectValue("FChartAccount","dateClosed","notNull",null);
end

rule FChartAccountIsDateClosedDefault when
	$e: FChartAccount(dateClosed == null)
then
	Calendar dateClosed = Calendar.getInstance();
	dateClosed.set(2100,1,1,0,0);
	modify( $e ) {
		setDateClosed(dateClosed.toInstant().atZone(ZoneId.systemDefault()).toLocalDate())
	}
end

