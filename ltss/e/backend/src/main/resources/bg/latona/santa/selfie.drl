rule ImportValueCreatingRelationWithPowerPlant
	salience -999
when
 	 $e: ImportValue(deleted == false && validationEvent.startsWith("afterSave"))
then
	PowerPlant powerPlant = droolsRuleProcedures.findPowerPlantByAccessPointAndCompanyAndDeleted($e.getReportingPointOwn(), $e.getCompany(), false);
	if (powerPlant != null) {
		insert($e);
		$e.setPowerPlant(powerPlant);
		entitiesToBeSaved.add($e);
	}
end

