rule OfferToClientRevisionDefault when
	$oc: OfferToClient(deleted == false && (revision == null || revision == 0) && originalOffer == null)
then
	modify( $oc ) {
		setRevision(1);
	}
	entitiesToBeSaved.add( $oc );
	warnings.add("OfferToClient.revision default", false);
end

rule OfferToClientOriginalOfferTraverseCheck when
	$oc: OfferToClient(deleted == false && originalOffer != null, this == $oc.originalOffer)
then
	warnings.rejectValue("OfferToClient","originalOffer","originalOffer.cycle",null);
end

rule OfferToClientOriginalOfferTraverse when
	$oc: OfferToClient(
		originalOffer != null 
		&& originalOffer.originalOffer != null 
		&& originalOffer != originalOffer.originalOffer
	)
then
	modify( $oc ) {
		setOriginalOffer($oc.getOriginalOffer().getOriginalOffer());
	}
	entitiesToBeSaved.add( $oc );
	warnings.add("OfferToClient.originalOffer traverse", false);
end

rule OfferToClientFirstRevision when
	$oc: OfferToClient((revision == null || revision == 0) && originalOffer != null && originalOffer.originalOffer == null)
	not Integer() from accumulate(
		OfferToClient($rev: revision) from droolsRuleProcedures.findOfferToClientByOriginalOffer($oc.originalOffer),
		max($rev)
	)
then
	modify( $oc ) {
		setRevision(2);
	}
	entitiesToBeSaved.add( $oc );
	warnings.add("OfferToClient.revision 2", false);
end

rule OfferToClientNextRevisions when
	$oc: OfferToClient((revision == null || revision == 0) && originalOffer != null && originalOffer.originalOffer == null)
	accumulate(
		OfferToClient($rev: revision) from droolsRuleProcedures.findOfferToClientByOriginalOffer($oc.originalOffer); 
		$maxRev: max($rev)
	)
then
	modify( $oc ) {
		setRevision(((Number)$maxRev).intValue() + 1);
	}
	entitiesToBeSaved.add( $oc );
	warnings.add("OfferToClient.revision "+$oc.getRevision(), false);
end

rule OfferToClientOfferCodeDefault when
	$oc: OfferToClient(id > 0 && (offerCode == null || offerCode.length() == 0) && createdDate != null && createdBy != null && revision > 0)
then
	OfferToClient originalOffer = $oc;
	if($oc.getOriginalOffer() != null) {
		originalOffer = $oc.getOriginalOffer();
	}
	Calendar createdDate = Calendar.getInstance();
	createdDate.setTime(originalOffer.getCreatedDate());
	$oc.setOfferCode(String.format(
			"%02d%02d%02d%.2s%05d/%02d",
			createdDate.get(Calendar.MONTH) + 1, //starts with 0 = JANUARY
			createdDate.get(Calendar.DAY_OF_MONTH),
			createdDate.get(Calendar.YEAR) % 100, //last 2 digits only
			originalOffer.getCreatedBy().getCode(),
			originalOffer.getId(),
			$oc.getRevision()
		));
	update( $oc );
	entitiesToBeSaved.add( $oc );
	warnings.add("OfferToClient.offerCode default", false);
end

rule OfferToClientNameDefault when
	$oc: OfferToClient((name == null || name.length() == 0) && offerCode != null && offerCode.length() > 0 && person != null)
then
	modify( $oc ) {
		setName("Оферта "+$oc.getOfferCode()+" към "+$oc.getPerson().getName());
	}
	entitiesToBeSaved.add( $oc );
	warnings.add("OfferToClient.name default", false);
end

