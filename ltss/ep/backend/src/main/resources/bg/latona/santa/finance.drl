rule FChartAccountCodeNull 
	salience -999
when
	$su: FChartAccount(deleted == false && (code == null || code.trim().isEmpty()))
then
	warnings.rejectValue("FChartAccount","code","notNull",null);
end

rule FChartAccountOutCodeNull 
	salience -999
when
	$su: FChartAccount(deleted == false && (outCode == null || outCode.deleted == true))
then
	warnings.rejectValue("FChartAccount","outCode","notNull",null);
end

rule CCcOrganizationUnitFkFChartAccount
	salience -999
when
	$e: CCcOrganizationUnit(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$fk: FChartAccount(deleted == false) from $e.fChartAccounts
then
	warnings.rejectValue("CCcOrganizationUnit","deleted","fkDenyDelete",$fk);
end

