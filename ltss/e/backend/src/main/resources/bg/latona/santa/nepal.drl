rule PowerPlantInstalledPowerMwValidation
	salience -999
when
	$su: PowerPlant(installedPowerMw != null && deleted == false && installedPowerMw.scale() > 4)
then
	warnings.rejectValue("PowerPlant","installedPowerMw","ContentInstalledPowerMw",null);
end

rule PowerPlantIdentificationNumberValidation
	salience -999
when
	$su: PowerPlant(identificationNumber != null && deleted == false)
then
	if($su.getIdentificationNumber().matches("[a-zA-Z0-9]+") && $su.getIdentificationNumber().length() == 33 && !$su.getIdentificationNumber().trim().substring(0,2).equals("BG")){
    		warnings.rejectValue("PowerPlant","identificationNumber","InputValidationBG",null);
    	} else if($su.getIdentificationNumber().matches("[a-zA-Z0-9]+") && $su.getIdentificationNumber().length() == 33 && $su.getIdentificationNumber().trim().substring(0,2).equals("BG")){
    	// intentionally left blank to record correct data
    	}  else if($su.getIdentificationNumber().matches("[a-zA-Z0-9]+") && $su.getIdentificationNumber().length() != 16) {
    		warnings.rejectValue("PowerPlant","identificationNumber","InputRestriction16Or33LettersAndDigits",null);
    	} else if (!$su.getIdentificationNumber().matches("[a-zA-Z0-9]+")){
			warnings.rejectValue("PowerPlant","identificationNumber","InputRestriction16Or33LettersAndDigits",null);
    	}
end

rule PowerPlantMinPriceMWhValidation
	salience -999
when
	$su: PowerPlant(minPriceMWh != null && deleted == false && minPriceMWh.setScale(0, BigDecimal.ROUND_DOWN) != minPriceMWh)
then
	warnings.rejectValue("PowerPlant","minPriceMWh","ContentOfInteger",null);
end

rule BankAccountIbanValidation
	salience -999
when
	$su: BankAccount(iban != null && deleted == false && (iban.matches("[a-zA-Z0-9]+") == false || iban.length() != 22
	|| (iban.length() == 22 && iban.substring(0,2).equals("BG") == false)))
then
	String ibanCode = "";
	String ibanBic = "";

	if($su.getIban().length() > 7){
		ibanCode = $su.getIban().trim().substring(2,4);
		ibanBic = $su.getIban().trim().substring(4,8);
	}

	if(!$su.getIban().substring(0,2).equals("BG")){
    		warnings.rejectValue("LegalPerson","iban","InputValidationBG",null);

    	} else if(!ibanCode.matches("[0-9]+") || !ibanBic.matches("[A-Z]+")){
    		warnings.rejectValue("BankAccount","iban","IbanInputRestriction",null);

    	}  else {
    		warnings.rejectValue("BankAccount","iban","InputRestriction22LettersAndDigits",null);
    	}
end

rule BankAccountBicValidation
	salience -999
when
	$su: BankAccount(bic != null && deleted == false && (bic.matches("[A-Z]+") == false || bic.length() != 8))
then
    	warnings.rejectValue("BankAccount","bic","BicInputRestriction",null);
end

