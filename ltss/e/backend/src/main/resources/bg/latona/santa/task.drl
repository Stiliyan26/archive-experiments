//rules that generate new entities
rule TaskWatcherAddCreator
when
	$t: Task(id > 0, createdBy != null, validationEvent.startsWith("after"))
	not TaskWatcher() from droolsRuleProcedures.findTaskWatcherByTaskAndWatcher($t,$t.createdBy)
then
	TaskWatcher taskWatcher = new TaskWatcher(null, null, null, null, false, $t.getCompany(), $t, $t.getCreatedBy());
	entitiesToBeSaved.add(taskWatcher);
	insert( taskWatcher );
	warnings.add("Add creator as task watcher", false);
end


//DELETE propagation rules

rule DeleteOfferToClientPropagate
when
	$deleted: OfferToClient(validationEvent.startsWith("after") && deleted == true)
then
	for(OfferLine offerLine : $deleted.getOfferLines()) {
		offerLine.setDeleted( true );
		entitiesToBeSaved.add( offerLine );
		insert( offerLine );
	}
end

//Invoice
rule InvoiceIsIssued when
	$inv: Invoice(id > 0 && validationEvent.startsWith("before") )
	$origInv: Invoice(deleted == false && isIssued == true) from cleanEmWrapper.getOriginalEntity($inv)
then
	if($origInv != null) {
		$origInv.setIsExported(true); //only isExported is allowed to be set to true
		if(!$inv.equals($origInv)) {
			warnings.rejectValue($inv.getClass().getSimpleName(),"isIssued","invoiceNum.isIssued",$inv.getIsIssued());
		}
	}
end

rule InvoiceInvoiceNumAutoinc when
	$inv: Invoice(isIssued == true && invoiceNum == null && validationEvent.startsWith("before"))
then
	BigDecimal maxNum = droolsRuleProcedures.getInvoiceMaxIssuedInvoiceNum();
	BigDecimal newNum;
	if(maxNum == null) {
		newNum = BigDecimal.ONE;
	} else {
		newNum = maxNum.add(BigDecimal.ONE);
	}
	modify( $inv ) {
		setInvoiceNum( newNum );
	}
	warnings.add($inv.getClass().getName()+".invoiceNum default", false);
end

rule InvoiceInvoiceNumNull
	salience -999
when
	$inv: Invoice(deleted == false && isIssued == true && invoiceNum == null && validationEvent.startsWith("before"))
then
	warnings.rejectValue($inv.getClass().getSimpleName(),"invoiceNum","notNull",null);
end

rule InvoiceInvoiceNumLast
	salience -999
when
	$inv: Invoice(isIssued == true && invoiceNum != null && validationEvent.startsWith("before")
				&& invoiceNum != droolsRuleProcedures.getInvoiceMaxIssuedInvoiceNum().add(BigDecimal.ONE) )
	$origInv: Invoice(deleted == false && (isIssued != true || invoiceNum == null)) from cleanEmWrapper.getOriginalEntity($inv)
then
	warnings.rejectValue($inv.getClass().getSimpleName(),"invoiceNum","invoiceNum.last",$inv.getInvoiceNum());
end

