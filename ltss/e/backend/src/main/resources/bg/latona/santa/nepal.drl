rule QuarterOfHourValueRange
	salience -999
when
	$e: QuarterOfHour((value < 0 || value > 100) && (validationEvent.startsWith("beforeCreate") ||  validationEvent.startsWith("beforeSave")))
then
	warnings.rejectValue("PowerPlant","value","denyQuarterOfHourValue",null);
end

rule PowerPlantProtocolSendMail when
 	 $e: PowerPlantProtocol(deleted == false && loiProtocolStatus!.listOptionItemCode == LoiProtocolStatus.SIGNED_PROTOCOL && validationEvent.startsWith("before") && company != null)
     $old: PowerPlantProtocol(deleted == false && loiProtocolStatus!.listOptionItemCode != LoiProtocolStatus.SIGNED_PROTOCOL && sendMailMessage == null) from cleanEmWrapper.getOriginalEntity($e)
then

    MailAccount mailAccount = droolsRuleProcedures.findMailAccountByDefaultAccountAndCompanyAndDeleted(true, currentUser.getCompany(), false);
    MailTemplate mailTemplate = droolsRuleProcedures.findMailTemplateByTemplateCodeAndCompanyAndDeleted(MailTemplate.MAIL_TEMPLATE_FOR_PROTOCOLS, currentUser.getCompany(), false);
    SecUser secUser = droolsRuleProcedures.findSecUserByNameAndDeleted("camel1", false);
    LoiProtocolStatus loiProtocolStatus = droolsRuleProcedures.findLoiProtocolStatusByCodeAndCompanyAndDeleted(LoiProtocolStatus.SIGNED_PROTOCOL, currentUser.getCompany(), false);

    List<DBFile> dbFileList = new ArrayList<>();
	DBFile dbFilePdf = new DBFile();
    		dbFilePdf.setName($e.getId() + "_Протокол_" + $e.getPowerPlant().getIdentificationNumber() + ".pdf");
    		dbFilePdf.setContent($e.getPdfFile());
    		dbFilePdf.setContentType("application/pdf");
    		entitiesToBeSaved.add(dbFilePdf);

    DBFile dbFileXLSX = new DBFile();
       		dbFileXLSX.setName($e.getId() + "_Excel_" + $e.getPowerPlant().getIdentificationNumber() + ".xlsx");
       		dbFileXLSX.setContent($e.getXlsxFile());
       		dbFileXLSX.setContentType("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
       		entitiesToBeSaved.add(dbFileXLSX);

    		dbFileList.add(dbFileXLSX);
    		dbFileList.add(dbFilePdf);

	if(dbFileList.size() != 0) {
		SendMailMessage mailMessage = new SendMailMessage();

   		mailMessage.setFromAccount(mailAccount);
   		mailMessage.setName(mailTemplate.getName());
   		mailMessage.setSendMailSubject(mailTemplate.getTemplateSubject());
   		mailMessage.setSendMailToRecipient(mailTemplate.getTemplateToRecipient());
   		mailMessage.setSendMailContent(mailTemplate.getTemplateContent());
   		mailMessage.setAttachments(dbFileList);
   		mailMessage.setSent(false);
   		mailMessage.setLastModifiedBy(secUser);
   		mailMessage.setCompany(secUser.getCompany());
   		entitiesToBeSaved.add(mailMessage);

		insert($old);
		modify($old){
		setSendMailMessage(mailMessage),
		setLoiProtocolStatus(loiProtocolStatus)
		}
		entitiesToBeSaved.add($old);

	}

end

