rule DBFileFkMailAttachment
	salience -999
when
	$e: DBFile(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$fk: MailAttachment(deleted == false) from $e.mailAttachments
then
	warnings.rejectValue("DBFile","deleted","fkDenyDelete",$fk);
end

rule MailMessageFkMailAttachment
	salience -999
when
	$e: MailMessage(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$fk: MailAttachment(deleted == false) from $e.mailAttachments
then
	warnings.rejectValue("MailMessage","deleted","fkDenyDelete",$fk);
end

rule MailAccountFkSendMailMessage
	salience -999
when
	$e: MailAccount(deleted == true || (id == triggerObject#CommonRecord.id && validationEvent.startsWith("beforeDelete")))
	$fk: SendMailMessage(deleted == false) from $e.sendMailMessages
then
	warnings.rejectValue("MailAccount","deleted","fkDenyDelete",$fk);
end

rule MailAccountDelayNull 
	salience -999
when
	$rec: MailAccount(deleted == false && (delay == null || delay == 0))
then
	warnings.rejectValue("MailAccount","delay","notNull",null);
end

//TODO validation for MailAccount - should be no more than one default
rule SendMailMessageDefaultAccount
when
	$mail: SendMailMessage(fromAccount == null && company != null)
	$account: MailAccount(id != null) from droolsRuleProcedures.findMailAccountByDefaultAccountAndCompanyAndDeleted(true, $mail.company, false)
then
	modify( $mail ) {
		setFromAccount( $account );
	}
	entitiesToBeSaved.add($mail);
	warnings.add("SendMailMessage.fromAccount default", false);
end

//TODO send mail when task is assigned to you - not the best trigger at the moment
rule TaskWatcherAddAssigned
when
	$t: Task(id > 0 && assigned != null && company != null && lastModifiedDate != null)
	not TaskWatcher() from droolsRuleProcedures.findTaskWatcherByTaskAndWatcher($t,$t.assigned)
	not SendMailMessage(name == "Известие за възложена задача #"+$t.id+" на "+$t.lastModifiedDate)
	not SendMailMessage() from droolsRuleProcedures.findSendMailMessageByNameAndCompany(
			"Известие за възложена задача #"+$t.id+" на "+$t.lastModifiedDate,
			$t.company)
then
	TaskWatcher taskWatcher = new TaskWatcher(null, null, null, null, false, $t.getCompany(), $t, $t.getAssigned());
	entitiesToBeSaved.add(taskWatcher);
	insert( taskWatcher );
	warnings.add("Add assigned as task watcher", false);
	
	if($t.getAssigned().getEmail() != null) {
		SendMailMessage newMail = new SendMailMessage(null, null, null, null, false, $t.getCompany(),
				"Известие за възложена задача #"+$t.getId()+" на "+$t.getLastModifiedDate(),
				new ArrayList(),
				null,
				"CRM: Известие за възложена задача #"+$t.getId()+" "+$t.getTitle(), 
				$t.getAssigned().getEmail(), 
				new ArrayList(),
				"Това писмо е изпратено автоматично от CRM системата като известие, че задача #"+$t.getId()+" "+$t.getTitle()+" беше възложена на Вас от потребител "+currentUser.getName(), 
				new ArrayList(), 
				false);
		entitiesToBeSaved.add(newMail);
		insert( newMail );
		warnings.add("Sent 'task assigned' notification mail to watcher "+$t.getAssigned().getEmail(), false);
	}
end

//TODO add rule for all changes in entities referencing a task
rule TaskUpdatedEmailNotification
	salience -999
when
	$t: Task(id > 0 && lastModifiedDate != null && company != null)
	not SendMailMessage(name == "Известие за промяна по задача #"+$t.id+" на "+$t.lastModifiedDate)
	not SendMailMessage() from droolsRuleProcedures.findSendMailMessageByNameAndCompany(
			"Известие за промяна по задача #"+$t.id+" на "+$t.lastModifiedDate,
			$t.company)
	$tw: TaskWatcher(watcher.name != currentUser.getName(), watcher.email != null) from droolsRuleProcedures.findTaskWatcherByTask($t)
then
	SendMailMessage newMail = new SendMailMessage(null, null, null, null, false, $t.getCompany(),
			"Известие за промяна по задача #"+$t.getId()+" на "+$t.getLastModifiedDate(),
			new ArrayList(),
			null,
			"CRM: Известие за промяна по задача #"+$t.getId()+" "+$t.getTitle(), 
			$tw.getWatcher().getEmail(), 
			new ArrayList(),
			"Това писмо е изпратено автоматично от CRM системата като известие, че задача #"+$t.getId()+" "+$t.getTitle()+" беше променена от потребител "+currentUser.getName(), 
			new ArrayList(), 
			false);
	entitiesToBeSaved.add(newMail);
	insert( newMail );
	warnings.add("Sent 'task updated' notification mail to watcher "+$tw.getWatcher().getEmail(), false);
end

rule TaskCommentUpdatedEmailNotification
	salience -999
when
	$tc: Comment(id > 0 && task != null && task.lastModifiedDate != null && company != null)
	not SendMailMessage(name == "Известие за промяна по задача #"+$tc.task.id+" на "+$tc.task.lastModifiedDate)
	not SendMailMessage() from droolsRuleProcedures.findSendMailMessageByNameAndCompany(
			"Известие за промяна по задача #"+$tc.task.id+" на "+$tc.task.lastModifiedDate,
			$tc.company)
	$tw: TaskWatcher(watcher.name != currentUser.getName(), watcher.email != null) from droolsRuleProcedures.findTaskWatcherByTask($tc.task)
then
	SendMailMessage newMail = new SendMailMessage(null, null, null, null, false, $tc.getCompany(),
			"Известие за промяна по задача #"+$tc.getTask().getId()+" на "+$tc.getTask().getLastModifiedDate(),
			new ArrayList(),
			null,
			"CRM: Известие за промяна по задача #"+$tc.getTask().getId()+" "+$tc.getTask().getTitle(), 
			$tw.getWatcher().getEmail(), 
			new ArrayList(),
			"Това писмо е изпратено автоматично от CRM системата като известие, че задача #"+$tc.getTask().getId()+" "+$tc.getTask().getTitle()+" има промяна по коментарите от потребител "+currentUser.getName(), 
			new ArrayList(), 
			false);
	entitiesToBeSaved.add(newMail);
	insert( newMail );
	warnings.add("Sent 'comment updated' notification mail to watcher "+$tw.getWatcher().getEmail(), false);
end

rule TaskAttachmentUpdatedEmailNotification
	salience -999
when
	$ta: TaskAttachment(id > 0 && task != null && task.lastModifiedDate != null && company != null)
	not SendMailMessage(name == "Известие за промяна по задача #"+$ta.task.id+" на "+$ta.task.lastModifiedDate)
	not SendMailMessage() from droolsRuleProcedures.findSendMailMessageByNameAndCompany(
			"Известие за промяна по задача #"+$ta.task.id+" на "+$ta.task.lastModifiedDate,
			$ta.company)
	$tw: TaskWatcher(watcher.name != currentUser.getName(), watcher.email != null) from droolsRuleProcedures.findTaskWatcherByTask($ta.task)
then
	SendMailMessage newMail = new SendMailMessage(null, null, null, null, false, $ta.getCompany(),
			"Известие за промяна по задача #"+$ta.getTask().getId()+" на "+$ta.getTask().getLastModifiedDate(),
			new ArrayList(),
			null,
			"CRM: Известие за промяна по задача #"+$ta.getTask().getId()+" "+$ta.getTask().getTitle(), 
			$tw.getWatcher().getEmail(), 
			new ArrayList(),
			"Това писмо е изпратено автоматично от CRM системата като известие, че задача #"+$ta.getTask().getId()+" "+$ta.getTask().getTitle()+" има промяна по прикачените документи от потребител "+currentUser.getName(), 
			new ArrayList(), 
			false);
	entitiesToBeSaved.add(newMail);
	insert( newMail );
	warnings.add("Sent 'task attachment updated' notification mail to "+$tw.getWatcher().getEmail(), false);
end

