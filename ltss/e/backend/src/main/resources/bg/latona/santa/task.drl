rule InvoiceInvoiceDateLatest
	salience -999
when
	$inv: Invoice(isIssued == true 
				&& invoiceDate != null 
				&& invoiceDate < droolsRuleProcedures.getInvoiceMaxIssuedInvoiceDate()
				&& validationEvent.startsWith("before"))
	$origInv: Invoice(deleted == false && (isIssued != true || invoiceDate == null)) from cleanEmWrapper.getOriginalEntity($inv)
then
	warnings.rejectValue($inv.getClass().getSimpleName(),"invoiceDate","invoiceDate.latest",$inv.getInvoiceDate());
end

rule InvoiceTaxBaseAmountFromInvoiceRow
	salience 20 //before UpdateInvoiceTaxAmount
when
	$irow: InvoiceRow(quantity != null && quantity != 0 && priceRate != null && priceRate != 0 && invoice != null && validationEvent.startsWith("before"))
	$inv: Invoice() from $irow.invoice
	accumulate(
		$rows: InvoiceRow($quantity: quantity, $priceRate: priceRate, quantity != null, priceRate != null, deleted != true, id != $irow.id) from $inv.invoiceRows; 
		$sum: sum($quantity.multiply($priceRate).setScale(2, BigDecimal.ROUND_HALF_UP))
	)
then
	BigDecimal newValue = $sum.add($irow.getQuantity().multiply($irow.getPriceRate()).setScale(2, BigDecimal.ROUND_HALF_UP));
	if( $inv.getTaxBaseAmount() == null || $inv.getTaxBaseAmount().compareTo(newValue) != 0 ) {
		insert( $inv );
		modify( $inv ) {
			setTaxBaseAmount( newValue );
		}
		entitiesToBeSaved.add( $inv );
		warnings.add($inv.getClass().getName()+".taxBaseAmount default", false);
	}
end

rule InvoiceTaxAmount
	salience 10 //before UpdateInvoiceTotalAmountDefault
when
	$inv: Invoice(taxBaseAmount != null && validationEvent.startsWith("before"))
then
	BigDecimal taxRate = ($inv.getVatExemptionReason() != null && LoiVatExemptionReason.VAT_EXEMPTION_REASON_NONE == $inv.getVatExemptionReason().getListOptionItemCode() ? (new BigDecimal(0.2)) : (BigDecimal.ZERO));
	BigDecimal newValue = taxRate.multiply($inv.getTaxBaseAmount()).setScale(2, BigDecimal.ROUND_HALF_UP);
	if( $inv.getTaxAmount() == null || $inv.getTaxAmount().compareTo(newValue) != 0 ) {
		modify( $inv ) {
			setTaxAmount( newValue );
		}
		warnings.add($inv.getClass().getName()+".taxAmount default", false);
	}
end

rule InvoiceTotalAmount
	salience 0
when
	$inv: Invoice(taxBaseAmount != null && taxAmount != null && validationEvent.startsWith("before"))
then
	BigDecimal newValue = $inv.getTaxBaseAmount().add($inv.getTaxAmount());
	if( $inv.getTotalAmount() == null || $inv.getTotalAmount().compareTo(newValue) != 0 ) {
		modify( $inv ) {
			setTotalAmount( newValue );
		}
		warnings.add($inv.getClass().getName()+".totalAmount default", false);
	}
end

//InvoiceRow
rule InvoiceRowInvoiceIsIssued when
	$invRow: InvoiceRow(deleted == false && invoice != null && invoice.isIssued == true && validationEvent.startsWith("before"))
then
	warnings.rejectValue($invRow.getInvoice().getClass().getSimpleName(),"isIssued","invoiceNum.isIssued",$invRow.getInvoice().getIsIssued());
end

rule InvoiceRowDescriptionFromTransport
when
	$invRow: InvoiceRow(transport != null && validationEvent.startsWith("before"))
then
	InvoiceRow origRow = (InvoiceRow) cleanEmWrapper.getOriginalEntity($invRow);
	if(origRow == null //row is created
			|| origRow.getTransport() == null //row is assigned a transport
			|| origRow.getTransport() != $invRow.getTransport() //row transport is changed
	) {
		String newValue = $invRow.getTransport().getRoute()
				+" "+$invRow.getTransport().getContainerNumber()
				+" "+($invRow.getTransport().getTractorUnit() != null ? $invRow.getTransport().getTractorUnit().getLicensePlate() : "")
				+($invRow.getTransport().getTrailer() != null ? "/"+$invRow.getTransport().getTrailer().getLicensePlate() : "");
		if($invRow.getInvoiceRowDescription() != newValue) {
			modify( $invRow ) {
				setInvoiceRowDescription( newValue );
			}
			warnings.add($invRow.getClass().getName()+".invoiceRowDescription default", false);
		}
	}
end

rule InvoiceRowPriceRateFromTransport
when
	$invRow: InvoiceRow(transport != null && validationEvent.startsWith("before"))
then
	InvoiceRow origRow = (InvoiceRow) cleanEmWrapper.getOriginalEntity($invRow);
	if(origRow == null //row is created
			|| origRow.getTransport() == null //row is assigned a transport
			|| origRow.getTransport() != $invRow.getTransport() //row transport is changed
			|| $invRow.getPriceRate() != $invRow.getTransport().getPaymentAmount() //value is different
	) {
		modify( $invRow ) {
			setPriceRate($invRow.getTransport().getPaymentAmount());
		}
		warnings.add($invRow.getClass().getName()+".priceRate from transport", false);
	}
end

rule InvoiceRowQuantityDefault
when
	$invRow: InvoiceRow(quantity == null && validationEvent.startsWith("before"))
then
	BigDecimal defaultValue = BigDecimal.ONE;
	modify( $invRow ) {
		setQuantity(defaultValue);
	}
	warnings.add($invRow.getClass().getName()+".quantity default", false);
end

